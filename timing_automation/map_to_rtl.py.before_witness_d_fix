DFF_SUFFIX_RE = re.compile(r"\$_DFF_[A-Za-z0-9_]+_$")
PIN_SUFFIX_RE = re.compile(r"/(?:Q|QN|D|CK)$")
SRC_RE = re.compile(
    r"^(?P<file>.*):(?P<start>\d+)"
    r"(?:\.(?P<start_col>\d+))?"
    r"(?:-(?P<end>\d+)(?:\.(?P<end_col>\d+))?)?$"
)

BITWISE_BINARY = {"$and", "$or", "$xor", "$xnor"}
BITWISE_UNARY = {"$not", "$pos"}
ARITH_CARRY = {"$add", "$sub"}

GLOBAL_OPS = {
