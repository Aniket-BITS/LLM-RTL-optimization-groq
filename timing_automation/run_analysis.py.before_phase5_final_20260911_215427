#!/usr/bin/env python3
"""
Unified pre-optimizer analysis pipeline for ORFS RTL timing closure.

Fresh run:
    python3 timing_automation/run_analysis.py \
        --design mapper_reconvergent_test \
        --platform nangate45

Resume an existing run:
    python3 timing_automation/run_analysis.py \
        --design mapper_reconvergent_test \
        --platform nangate45 \
        --variant run_20260905_234646_9cbc56 \
        --resume

Force one stage and every downstream stage:
    python3 timing_automation/run_analysis.py \
        --design mapper_reconvergent_test \
        --platform nangate45 \
        --variant run_20260905_234646_9cbc56 \
        --resume \
        --force-stage mapping

The component scripts remain independently runnable. This orchestrator owns:
  * sequencing
  * FLOW_VARIANT propagation
  * logical timing-report discovery
  * artifact freshness / dependency invalidation
  * fail-fast validation
  * pipeline execution manifest
  * final optimizer_ready trust gate
"""

from __future__ import annotations

