def required_scripts(script_dir: Path) -> Dict[str, Path]:
    return {
        "run_flow": script_dir / "run_flow.py",
        "collect_metrics": script_dir / "collect_metrics.py",
        "parse_timing": script_dir / "parse_timing.py",
        "build_rtl_graph": script_dir / "build_rtl_graph.py",
        "map_to_rtl": script_dir / "map_to_rtl.py",
        "solve_select_sat": script_dir / "solve_select_sat.py",
        "classify_path": script_dir / "classify_path.py",
        "build_optimizer_input": script_dir / "build_optimizer_input.py",
        "report_checks": script_dir / "report_checks.tcl",
        "report_witness": script_dir / "report_witness.tcl",
        "run_stage_reports": script_dir / "run_stage_reports.py",
    }


def preflight(
    flow_dir: Path,
    script_dir: Path,
    design: str,
    platform: str,
) -> Tuple[Dict[str, Path], Path]:
    scripts = required_scripts(script_dir)
    missing = [str(path) for path in scripts.values() if not path.exists()]
    if missing:
        raise PipelineError(
            "preflight",
            "Required pipeline files are missing:\n  " + "\n  ".join(missing),
        )

    config = flow_dir / "designs" / platform / design / "config.mk"
    if not config.exists():
        raise PipelineError(
            "preflight",
            f"Design configuration not found: {config}",
        )

    ai_runs = flow_dir / "ai_runs"
    ai_runs.mkdir(parents=True, exist_ok=True)

    # Basic syntax check of every Python stage before starting a costly flow.
    for name, path in scripts.items():
        if path.suffix != ".py":
            continue
        result = subprocess.run(
            [sys.executable, "-m", "py_compile", str(path)],
            cwd=str(flow_dir),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise PipelineError(
                "preflight",
                f"Python syntax check failed for {name} ({path}):\n{result.stderr.strip()}",
            )

    return scripts, config


def discover_timing_reports(
    report_dir: Path,
    *,
    include_witness_reports: bool = False,
) -> List[Path]:
    """Discover generic per-clock reports emitted by report_checks.tcl.

    Witness reports live in dedicated witness subdirectories and are never
    considered ordinary optimization path groups. ``include_witness_reports``
    is retained only for CLI backward compatibility.
    """
    del include_witness_reports
    if not report_dir.exists():
        raise PipelineError("timing", f"ORFS report directory not found: {report_dir}")

    per_group = sorted(
        p.resolve()
        for p in report_dir.glob("*_critical_paths.rpt")
        if p.is_file() and not p.name.endswith("_reg2reg_critical_paths.rpt")
    )
    if per_group:
        return per_group

    # Backward-compatible discovery for pre-Phase-5 report directories.
    legacy_reg2reg = report_dir / "reg2reg_critical_paths.rpt"
    if legacy_reg2reg.exists():
        return [legacy_reg2reg.resolve()]
    legacy_generic = report_dir / "critical_paths.rpt"
    if legacy_generic.exists():
        return [legacy_generic.resolve()]

    raise PipelineError(
        "timing",
        "No usable timing report was found. Expected <group>_critical_paths.rpt "
        f"under {report_dir}",
    )


