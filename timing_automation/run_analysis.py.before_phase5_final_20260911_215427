def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_design_top(config: Path) -> str:
    """
    Resolve the actual Verilog top module from an ORFS config.mk.

    ``--design`` is allowed to be an ORFS/benchmark nickname (for example
    ``dr_ticket_machine``), while DESIGN_NAME is the module Yosys must use
    (for example ``ticket_machine``). Legacy designs where both names are
    identical continue to work unchanged.
    """
    config = Path(config).resolve()

    if not config.is_file():
        raise PipelineError(
            "preflight",
            f"config.mk not found while resolving RTL top: {config}",
        )

    text = config.read_text(encoding="utf-8", errors="replace")
    match = re.search(
        r"^\s*(?:export\s+)?DESIGN_NAME\s*(?::=|\?=|\+=|=)\s*([^\s#]+)",
        text,
        flags=re.MULTILINE,
    )

    if not match:
        raise PipelineError(
            "preflight",
            f"DESIGN_NAME not found in {config}",
        )

    top = match.group(1).strip().strip('\"\'')

    if not top or "$(" in top or "${" in top:
        raise PipelineError(
            "preflight",
            f"DESIGN_NAME must resolve to a literal module name in {config}; got {top!r}",
        )

    return top


def read_json(path: Path, stage: str) -> Dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise PipelineError(stage, f"Required JSON artifact not found: {path}")
    except json.JSONDecodeError as exc:
        raise PipelineError(stage, f"Malformed JSON artifact {path}: {exc}")
    except OSError as exc:
        raise PipelineError(stage, f"Could not read {path}: {exc}")

    if not isinstance(data, dict):
        raise PipelineError(stage, f"Expected a JSON object in {path}")
    return data


def write_json_atomic(path: Path, data: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def sanitize_report_tag(report_file: Path) -> str:
    tag = re.sub(r"[^A-Za-z0-9_.-]+", "_", report_file.stem)
    return tag.strip("_.-") or "report"


def artifact_fresh(output: Path, inputs: Iterable[Path]) -> bool:
    """Return True only when output exists and is at least as new as all inputs."""
    if not output.exists():
        return False
    try:
        out_mtime = output.stat().st_mtime_ns
        for item in inputs:
            if item.exists() and out_mtime < item.stat().st_mtime_ns:
                return False
    except OSError:
        return False
    return True


def stage_index(name: Optional[str]) -> Optional[int]:
    if name is None:
        return None
    return STAGE_ORDER.index(name)


def force_applies(force_stage: Optional[str], current_stage: str) -> bool:
    forced = stage_index(force_stage)
    if forced is None:
        return False
    return STAGE_ORDER.index(current_stage) >= forced


def command_text(command: Sequence[str]) -> str:
    return " ".join(subprocess.list2cmdline([str(x)]) for x in command)


def stage_banner(name: str, detail: Optional[str] = None) -> None:
    print()
    print("=" * 72)
    print(name)
    if detail:
        print(detail)
    print("=" * 72)


def run_command(
    command: Sequence[str],
    *,
    cwd: Path,
    stage: str,
    group: Optional[str] = None,
    verbose: bool = False,
) -> None:
    if verbose:
        print("Command:")
        print("  " + " ".join(str(x) for x in command))
        print()

    try:
        result = subprocess.run(
            [str(x) for x in command],
            cwd=str(cwd),
            text=True,
        )
    except OSError as exc:
        raise PipelineError(
            stage,
            f"Could not start command: {exc}",
            group=group,
            command=command,
        )

    if result.returncode != 0:
        raise PipelineError(
            stage,
            f"Stage command returned exit code {result.returncode}",
            group=group,
            command=command,
        )


def ensure_context(
    data: Dict[str, Any],
    *,
    design: str,
    platform: str,
    variant: str,
    path: Path,
    stage: str,
) -> None:
    actual_design = data.get("design")
    actual_platform = data.get("platform")
    actual_variant = data.get("flow_variant")

    # build_optimizer_input.py nests design context under design{}.
    if isinstance(actual_design, dict):
        actual_platform = actual_design.get("platform")
        actual_variant = actual_design.get("flow_variant")
        actual_design = actual_design.get("name")

    for label, actual, expected in (
        ("design", actual_design, design),
        ("platform", actual_platform, platform),
        ("flow_variant", actual_variant, variant),
    ):
        if actual is not None and str(actual) != str(expected):
            raise PipelineError(
                stage,
                f"{path.name}: {label} mismatch: expected {expected!r}, got {actual!r}",
            )


def _load_run_flow_provenance_helpers(
    script_dir: Path,
):
    """
    Import the provenance helpers from the same run_flow.py used by this
    pipeline. This keeps fresh-run and resume hashing semantics identical.
    """
    if str(script_dir) not in sys.path:
        sys.path.insert(
            0,
            str(script_dir),
        )

    try:
        import run_flow as run_flow_module  # type: ignore
    except Exception as exc:
        raise PipelineError(
            "flow",
            (
                "Could not import flow-input provenance "
                f"helpers from run_flow.py: {exc}"
            ),
        )

    required = (
        "capture_flow_input_snapshot",
        "compare_flow_input_snapshots",
        "format_flow_input_mismatch",
    )

    missing = [
        name
        for name in required
        if not hasattr(
            run_flow_module,
            name,
        )
    ]

    if missing:
        raise PipelineError(
            "flow",
            (
                "run_flow.py does not provide the required "
                "flow-input provenance contract: "
                + ", ".join(
                    missing
                )
                + ". Start with the updated run_flow.py."
            ),
        )

    return run_flow_module


def verify_current_flow_inputs(
    *,
    script_dir: Path,
    run_info: Dict[str, Any],
    design: str,
    platform: str,
    phase: str,
) -> Dict[str, Any]:
    """
    Prove that the CURRENT source/config/constraint/report-script tree is
    byte-identical to the tree captured before this ORFS FLOW_VARIANT ran.

    Old manifests without the cryptographic snapshot are deliberately not
    resumable: there is no trustworthy way to reconstruct historical inputs.
    """
    integrity = run_info.get(
        "flow_input_integrity"
    )

    if not isinstance(
        integrity,
        dict,
    ):
        raise PipelineError(
            "flow",
            (
                "This FLOW_VARIANT predates flow-input "
                "cryptographic provenance. Resume is unsafe. "
                "Start a fresh analysis run."
            ),
        )

    expected = integrity.get(
        "pre_flow"
    )

    if not isinstance(
        expected,
        dict,
    ):
        raise PipelineError(
            "flow",
            (
                "Run manifest is missing the pre-flow input "
                "snapshot. Resume is unsafe; start a fresh run."
            ),
        )

    if integrity.get(
        "status"
    ) != "verified":
        raise PipelineError(
            "flow",
            (
                "The ORFS run manifest does not contain a "
                "verified pre/post flow-input match. "
                "Do not reuse this FLOW_VARIANT."
            ),
        )

    module = (
        _load_run_flow_provenance_helpers(
            script_dir
        )
    )

    try:
        current = (
            module.capture_flow_input_snapshot(
                design,
                platform,
            )
        )

        differences = (
            module.compare_flow_input_snapshots(
                expected,
                current,
            )
        )
    except PipelineError:
        raise
    except Exception as exc:
        raise PipelineError(
            "flow",
            (
                "Could not verify current ORFS flow inputs "
                f"during {phase}: {exc}"
            ),
        )

    if not differences.get(
        "matches"
    ):
        message = (
            module.format_flow_input_mismatch(
                differences
            )
        )

        raise PipelineError(
            "flow",
            (
                f"{message}\n\n"
                f"Verification phase: {phase}"
            ),
        )

    return {
        "status": "verified",
        "phase": phase,
        "verified_at": utc_now(),
        "aggregate_sha256": current.get(
            "aggregate_sha256"
        ),
        "file_count": current.get(
            "file_count"
        ),
    }




