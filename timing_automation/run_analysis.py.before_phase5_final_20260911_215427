def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Run the complete trusted pre-optimizer RTL timing analysis pipeline."
    )
    p.add_argument("--design", required=True)
    p.add_argument("--platform", default="nangate45")
    p.add_argument("--flow-dir", type=Path, default=DEFAULT_FLOW_DIR)
    p.add_argument("--prefix", default="run", help="Fresh FLOW_VARIANT prefix")
    p.add_argument("--variant", default=None, help="Existing FLOW_VARIANT for --resume")
    p.add_argument(
        "--liberty",
        action="append",
        default=[],
        help=(
            "Exact Liberty file for physical-stage replay. "
            "May be specified multiple times."
        ),
    )
    p.add_argument("--resume", action="store_true", help="Reuse a prior ORFS run and fresh valid artifacts")
    p.add_argument(
        "--force-stage",
        choices=("metrics", "timing", "mapping", "witness", "classification", "optimizer_input"),
        default=None,
        help="Regenerate this stage and every downstream stage during --resume",
    )
    p.add_argument(
        "--include-witness-reports",
        action="store_true",
        help="Deprecated compatibility flag; witness reports are now isolated in the two-pass witness stage.",
    )
    p.add_argument(
        "--context-lines",
        type=int,
        default=12,
        help="Pass through to build_optimizer_input.py",
    )
    p.add_argument(
        "--minimum-confidence",
        choices=("low", "medium", "high"),
        default="high",
        help="Minimum classification confidence for final optimizer readiness",
    )
    p.add_argument(
        "--wns-tolerance-ns",
        type=float,
        default=0.005,
        help="Global WNS vs observed-worst-path tolerance for final builder",
    )
    p.add_argument("--allow-latency-change", action="store_true")
    p.add_argument("--allow-pipeline", action="store_true")
    p.add_argument("--allow-retiming", action="store_true")
    p.add_argument("--verbose", action="store_true")
    return p.parse_args()


def main() -> int:
    args = parse_args()
    flow_dir = args.flow_dir.resolve()
    script_dir = Path(__file__).resolve().parent
    ai_runs = flow_dir / "ai_runs"

    if args.resume and not args.variant:
        print("ERROR: --resume requires --variant", file=sys.stderr)
        return 2
    if args.variant and not args.resume:
        print("ERROR: --variant is only valid with --resume", file=sys.stderr)
        return 2
    if args.force_stage and not args.resume:
        print("ERROR: --force-stage requires --resume", file=sys.stderr)
        return 2
    if args.allow_pipeline and not args.allow_latency_change:
        print("ERROR: --allow-pipeline requires --allow-latency-change", file=sys.stderr)
        return 2

    manifest = new_manifest(
        design=args.design,
        platform=args.platform,
        variant=args.variant,
        flow_dir=flow_dir,
        resume=args.resume,
        force_stage=args.force_stage,
    )
    manifest_path: Optional[Path] = None

    try:
        stage_banner("PREFLIGHT")
        scripts, config = preflight(
            flow_dir,
            script_dir,
            args.design,
            args.platform,
        )
        rtl_top = read_design_top(config)
        manifest["rtl_top"] = rtl_top

        mark_stage(
            manifest,
            "preflight",
            "passed",
            config=str(config),
            rtl_top=rtl_top,
            scripts={k: str(v) for k, v in scripts.items()},
        )
        print("PASS: scripts, config, report_checks.tcl, and Python syntax")
        print(f"Design ID : {args.design}")
        print(f"RTL top   : {rtl_top}")

        # ---------------------------------------------------------------
        # FLOW
        # ---------------------------------------------------------------
        stage_banner("FLOW", "ORFS baseline")
        if args.resume:
            assert args.variant is not None

            run_info = load_resume_run(
                ai_runs,
                args.design,
                args.platform,
                args.variant,
            )

            variant = args.variant

            flow_integrity = (
                verify_current_flow_inputs(
                    script_dir=script_dir,
                    run_info=run_info,
                    design=args.design,
                    platform=args.platform,
                    phase="resume_start",
                )
            )

            mark_stage(
                manifest,
                "flow",
                "reused",
                run_manifest=str(
                    ai_runs
                    / f"{variant}.json"
                ),
                flow_input_integrity=flow_integrity,
            )

            print(
                f"REUSE: {variant}"
            )

            print(
                "Flow inputs : VERIFIED "
                f"({flow_integrity['file_count']} files)"
            )

            print(
                "Input SHA   : "
                f"{flow_integrity['aggregate_sha256']}"
            )

        else:
            run_info = run_fresh_flow(
                script_dir,
                args.design,
                args.platform,
                args.prefix,
            )

            variant = str(
                run_info[
                    "flow_variant"
                ]
            )

            # run_flow.py already compares the pre/post ORFS snapshots.
            # Verify once more against the current bytes before downstream
            # analysis starts, closing the gap after run_flow() returns.
            flow_integrity = (
                verify_current_flow_inputs(
                    script_dir=script_dir,
                    run_info=run_info,
                    design=args.design,
                    platform=args.platform,
                    phase="post_flow_before_analysis",
                )
            )

            mark_stage(
                manifest,
                "flow",
                "passed",
                run_manifest=str(
                    ai_runs
                    / f"{variant}.json"
                ),
                flow_input_integrity=flow_integrity,
            )

        manifest["flow_variant"] = variant
        manifest_path = ai_runs / f"{variant}_pipeline.json"
        write_json_atomic(manifest_path, manifest)

        run_manifest_path = ai_runs / f"{variant}.json"
        report_dir = Path(run_info["report_dir"]).resolve()

        # ---------------------------------------------------------------
        # METRICS
        # ---------------------------------------------------------------
        stage_banner("METRICS", "Canonical WNS / TNS / area / power")
        metrics_path = ai_runs / f"{variant}_metrics.json"
        rerun_metrics = (
            not args.resume
            or force_applies(args.force_stage, "metrics")
            or not artifact_fresh(metrics_path, [scripts["collect_metrics"], run_manifest_path])
        )
        if rerun_metrics:
            command = [
                sys.executable,
                str(scripts["collect_metrics"]),
                "--variant", variant,
                "--design", args.design,
                "--platform", args.platform,
                "--flow-dir", str(flow_dir),
                "--output", str(metrics_path),
            ]
            run_command(command, cwd=flow_dir, stage="metrics", verbose=args.verbose)
            status = "passed"
        else:
            print(f"REUSE: {metrics_path.name}")
            status = "reused"
        metrics_data = validate_metrics(metrics_path, args.design, args.platform, variant)
        mark_stage(
            manifest,
            "metrics",
            status,
            output=str(metrics_path),
            metrics=metrics_data.get("metrics"),
        )
        manifest["artifacts"]["metrics"] = str(metrics_path)
        write_json_atomic(manifest_path, manifest)

        # ---------------------------------------------------------------
        # TIMING
        # ---------------------------------------------------------------
        stage_banner("TIMING", "Stage-consistent report_checks.rpt -> structured path JSON")

        # ---------------------------------------------------------------
        # Physical-stage-consistent timing reports
        #
        # Canonical PPA metrics and timing paths must come from the same
        # physical stage.  Final-stage reports live directly under:
        #
        #     reports/<platform>/<design>/<variant>/
        #
        # Earlier physical stages are explicitly materialized by
        # run_stage_reports.py under:
        #
        #     reports/<platform>/<design>/<variant>/stages/<stage>/
        #
        # Never silently fall back from a requested non-final stage to the
        # final reports: doing so can pair e.g. global-route PPA with final
        # timing paths and invalidate optimizer input.
        # ---------------------------------------------------------------

        timing_stage = "final"

        evaluation = metrics_data.get("evaluation")
        if isinstance(evaluation, dict):
            raw_stage = evaluation.get("stage")
            if isinstance(raw_stage, str) and raw_stage.strip():
                timing_stage = raw_stage.strip()

        if timing_stage == "final":
            timing_report_dir = report_dir
            stage_report_metadata = None
        else:
            timing_report_dir = (
                report_dir
                / "stages"
                / timing_stage
            )

            stage_report_metadata = (
                ai_runs
                / f"{variant}_{timing_stage}_stage_reports.json"
            )

            if not timing_report_dir.is_dir():
                raise PipelineError(
                    "Metrics request physical stage "
                    f"{timing_stage!r}, but the matching timing-report "
                    f"directory does not exist: {timing_report_dir}. "
                    "Generate it with run_stage_reports.py before "
                    "running timing analysis."
                )

            if not stage_report_metadata.is_file():
                raise PipelineError(
                    "Stage timing-report metadata is missing: "
                    f"{stage_report_metadata}"
                )

            try:
                stage_report_data = json.loads(
                    stage_report_metadata.read_text(encoding="utf-8")
                )
            except (OSError, json.JSONDecodeError) as exc:
                raise PipelineError(
                    "Could not read stage timing-report metadata "
                    f"{stage_report_metadata}: {exc}"
                ) from exc

            if stage_report_data.get("ok") is not True:
                raise PipelineError(
                    "Stage timing-report metadata is not marked valid: "
                    f"{stage_report_metadata}"
                )

            metadata_stage = (
                stage_report_data.get("evaluation", {}).get("stage")
                if isinstance(
                    stage_report_data.get("evaluation"),
                    dict,
                )
                else None
            )

            if metadata_stage != timing_stage:
                raise PipelineError(
                    "Stage timing-report metadata mismatch: "
                    f"metrics stage={timing_stage!r}, "
                    f"report stage={metadata_stage!r}"
                )

        manifest["timing_report_stage"] = timing_stage
        manifest["timing_report_dir"] = str(timing_report_dir)

        if stage_report_metadata is not None:
            manifest["artifacts"]["stage_reports"] = str(
                stage_report_metadata
            )

        print(f"Timing stage : {timing_stage}")
        print(f"Report dir   : {timing_report_dir}")

        reports = discover_timing_reports(
            timing_report_dir,
            include_witness_reports=args.include_witness_reports,
        )

        manifest["selected_reports"] = [str(p) for p in reports]

        print("Selected reports:")
        for report in reports:
            print(f"  - {report.name}")

        timing_artifacts: Dict[str, Path] = {}
        timing_counts: Dict[str, int] = {}
        timing_reran = False
        for report in reports:
            group, output = timing_output_for(ai_runs, variant, report)
            timing_artifacts[group] = output
            needs_run = (
                not args.resume
                or force_applies(args.force_stage, "timing")
                or not artifact_fresh(output, [report, scripts["parse_timing"]])
            )
            if needs_run:
                timing_reran = True
                print(f"\nParsing group: {group}")
                command = [
                    sys.executable,
                    str(scripts["parse_timing"]),
                    "--variant", variant,
                    "--design", args.design,
                    "--platform", args.platform,
                    "--flow-dir", str(flow_dir),
                    "--report", str(report),
                    "--output", str(output),
                ]
                run_command(
                    command,
                    cwd=flow_dir,
                    stage="timing",
                    group=group,
                    verbose=args.verbose,
                )
            else:
                print(f"REUSE {group}: {output.name}")

            data = validate_timing(output, args.design, args.platform, variant)
            timing_counts[group] = len(data["paths"])

        groups = sorted(timing_artifacts)
        manifest["path_groups"] = groups
        mark_stage(
            manifest,
            "timing",
            "passed" if timing_reran else "reused",
            groups=groups,
            path_counts=timing_counts,
            total_paths=sum(timing_counts.values()),
        )
        manifest["artifacts"]["timing"] = {
            g: str(p) for g, p in timing_artifacts.items()
        }
        write_json_atomic(manifest_path, manifest)

        # ---------------------------------------------------------------
        # MAPPING
        # ---------------------------------------------------------------

        # Do not let a source/config/SDC edit made after the ORFS stage get
        # paired with an old checkpoint/physical timing run.
        flow_integrity_before_mapping = (
            verify_current_flow_inputs(
                script_dir=script_dir,
                run_info=run_info,
                design=args.design,
                platform=args.platform,
                phase="before_mapping",
            )
        )

        manifest[
            "stages"
        ][
            "flow"
        ][
            "flow_input_integrity_before_mapping"
        ] = flow_integrity_before_mapping

        write_json_atomic(
            manifest_path,
            manifest,
        )

        stage_banner("RTL MAPPING", "Bit-precise pre-ABC cone + mapping-time SHA-256")
        mapped_artifacts: Dict[str, Path] = {}
        mapped_counts: Dict[str, int] = {}
        mapping_reran = False
        rtl_graph_path = ai_runs / f"{variant}_rtl_graph.json"

        for group in groups:
            timing_path = timing_artifacts[group]
            mapped_path = mapped_output_for(ai_runs, variant, group)
            mapped_artifacts[group] = mapped_path
            needs_run = (
                not args.resume
                or timing_reran
                or force_applies(args.force_stage, "mapping")
                or not artifact_fresh(
                    mapped_path,
                    [timing_path, scripts["map_to_rtl"], scripts["build_rtl_graph"]],
                )
            )
            if needs_run:
                mapping_reran = True
                print(f"\nMapping group: {group}")
                command = [
                    sys.executable,
                    str(scripts["map_to_rtl"]),
                    "--variant", variant,
                    "--design", args.design,
                    "--top", rtl_top,
                    "--platform", args.platform,
                    "--flow-dir", str(flow_dir),
                    "--timing-json", str(timing_path),
                    "--rtl-graph", str(rtl_graph_path),
                    "--output", str(mapped_path),
                ]
                run_command(
                    command,
                    cwd=flow_dir,
                    stage="mapping",
                    group=group,
                    verbose=args.verbose,
                )
            else:
                print(f"REUSE {group}: {mapped_path.name}")

            mapped = validate_mapping(
                mapped_path,
                timing_path,
                args.design,
                args.platform,
                variant,
                group,
                allow_pending_witness=True,
            )
            mapped_counts[group] = len(mapped["paths"])

        if not rtl_graph_path.exists():
            raise PipelineError("mapping", f"RTL graph was not produced: {rtl_graph_path}")

        mark_stage(
            manifest,
            "mapping",
            "passed" if mapping_reran else "reused",
            groups=groups,
            mapped_counts=mapped_counts,
            total_mapped=sum(mapped_counts.values()),
            rtl_graph=str(rtl_graph_path),
        )
        manifest["artifacts"]["rtl_graph"] = str(rtl_graph_path)
        manifest["artifacts"]["mapped"] = {
            g: str(p) for g, p in mapped_artifacts.items()
        }
        write_json_atomic(manifest_path, manifest)

        # ---------------------------------------------------------------
        # SELECT SAT
        #
        # Prove logical feasibility of mux-select values on exactly the
        # same pre-ABC Yosys representation used by RTL mapping.
        #
        # This stage records logical sensitization evidence only.
        # It MUST NOT be interpreted as physical narrowing.
        # ---------------------------------------------------------------

        stage_banner(
            "SELECT SAT",
            "Logical mux-branch feasibility on exact pre-ABC model",
        )

        select_sat_artifacts: Dict[str, Path] = {}
        select_sat_group_details: Dict[str, Dict[str, Any]] = {}

        select_sat_total_selectors = 0
        select_sat_total_resolved = 0
        select_sat_total_both_reachable = 0
        select_sat_total_unsupported = 0
        select_sat_total_solver_errors = 0

        select_sat_reran = False

        rtl_graph_doc = read_json(
            rtl_graph_path,
            "select_sat",
        )

        checkpoint_raw = rtl_graph_doc.get(
            "source_checkpoint"
        )

        checkpoint_path = (
            Path(checkpoint_raw).resolve()
            if isinstance(checkpoint_raw, str)
            and checkpoint_raw
            else None
        )

        yosys_raw = rtl_graph_doc.get(
            "yosys_executable"
        )

        yosys_path = (
            Path(yosys_raw).resolve()
            if isinstance(yosys_raw, str)
            and yosys_raw
            else None
        )


        for group in groups:

            mapped_path = mapped_artifacts[
                group
            ]

            mapped_doc = read_json(
                mapped_path,
                "select_sat",
            )

            selector_bits = set()

            for item in (
                mapped_doc.get("paths")
                or []
            ):

                if not isinstance(
                    item,
                    dict,
                ):
                    continue

                mapping = (
                    item.get("rtl_mapping")
                    or {}
                )

                if not isinstance(
                    mapping,
                    dict,
                ):
                    continue

                for point in (
                    mapping.get(
                        "logical_branch_points"
                    )
                    or []
                ):

                    if not isinstance(
                        point,
                        dict,
                    ):
                        continue

                    for raw_bit in (
                        point.get(
                            "select_bits"
                        )
                        or []
                    ):

                        if isinstance(
                            raw_bit,
                            int,
                        ):
                            selector_bits.add(
                                raw_bit
                            )


            # No mux-select ambiguity in this group.
            if not selector_bits:
                continue


            if mapped_path.name.endswith(
                "_rtl_mapped.json"
            ):

                sat_name = (
                    mapped_path.name[
                        :-len(
                            "_rtl_mapped.json"
                        )
                    ]
                    + "_select_sat.json"
                )

            else:

                sat_name = (
                    mapped_path.stem
                    + "_select_sat.json"
                )


            sat_path = mapped_path.with_name(
                sat_name
            )

            select_sat_artifacts[
                group
            ] = sat_path


            freshness_inputs = [
                mapped_path,
                rtl_graph_path,
                scripts[
                    "solve_select_sat"
                ],
            ]

            if (
                checkpoint_path is not None
                and checkpoint_path.exists()
            ):
                freshness_inputs.append(
                    checkpoint_path
                )

            if (
                yosys_path is not None
                and yosys_path.exists()
            ):
                freshness_inputs.append(
                    yosys_path
                )


            needs_run = (
                not args.resume
                or mapping_reran
                or not artifact_fresh(
                    sat_path,
                    freshness_inputs,
                )
            )


            if needs_run:

                select_sat_reran = True

                print(
                    f"\nSolving select feasibility "
                    f"for group: {group}"
                )

                command = [
                    sys.executable,
                    str(
                        scripts[
                            "solve_select_sat"
                        ]
                    ),
                    "--mapped-json",
                    str(
                        mapped_path
                    ),
                    "--rtl-graph",
                    str(
                        rtl_graph_path
                    ),
                    "--output",
                    str(
                        sat_path
                    ),
                ]

                if yosys_path is not None:

                    command.extend(
                        [
                            "--yosys",
                            str(
                                yosys_path
                            ),
                        ]
                    )

                run_command(
                    command,
                    cwd=flow_dir,
                    stage="select_sat",
                    group=group,
                    verbose=args.verbose,
                )

            else:

                print(
                    f"REUSE {group}: "
                    f"{sat_path.name}"
                )


            sat_doc = read_json(
                sat_path,
                "select_sat",
            )


            if (
                sat_doc.get("schema")
                != "nebula_select_sat/1"
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: unexpected "
                        "select-SAT schema: "
                        f"{sat_doc.get('schema')}"
                    ),
                    group=group,
                )


            if (
                sat_doc.get("design")
                != args.design
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: select-SAT "
                        "design mismatch"
                    ),
                    group=group,
                )


            if (
                sat_doc.get("platform")
                != args.platform
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: select-SAT "
                        "platform mismatch"
                    ),
                    group=group,
                )


            if (
                sat_doc.get(
                    "flow_variant"
                )
                != variant
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: select-SAT "
                        "flow-variant mismatch"
                    ),
                    group=group,
                )


            if (
                sat_doc.get(
                    "graph_identity_verified"
                )
                is not True
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: pre-ABC "
                        "graph identity was not "
                        "verified"
                    ),
                    group=group,
                )


            summary = (
                sat_doc.get("summary")
                or {}
            )


            select_count = int(
                summary.get(
                    "select_count"
                )
                or 0
            )

            resolved_count = int(
                summary.get(
                    "resolved_count"
                )
                or 0
            )

            both_reachable_count = int(
                summary.get(
                    "both_reachable_count"
                )
                or 0
            )

            unsupported_count = int(
                summary.get(
                    "unsupported_count"
                )
                or 0
            )

            solver_error_count = int(
                summary.get(
                    "solver_error_count"
                )
                or 0
            )


            if (
                select_count
                != len(
                    selector_bits
                )
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: mapped RTL "
                        f"contains "
                        f"{len(selector_bits)} "
                        "unique select bit(s), "
                        "but SAT artifact reports "
                        f"{select_count}"
                    ),
                    group=group,
                )


            if solver_error_count:

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: "
                        f"{solver_error_count} "
                        "select-SAT solver "
                        "error(s)"
                    ),
                    group=group,
                )


            if (
                resolved_count
                + unsupported_count
                != select_count
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: invalid "
                        "select-SAT accounting: "
                        f"select={select_count}, "
                        f"resolved={resolved_count}, "
                        "unsupported="
                        f"{unsupported_count}"
                    ),
                    group=group,
                )


            if (
                both_reachable_count
                > resolved_count
            ):

                raise PipelineError(
                    "select_sat",
                    (
                        f"{group}: invalid "
                        "both-reachable count"
                    ),
                    group=group,
                )


            select_sat_total_selectors += (
                select_count
            )

            select_sat_total_resolved += (
                resolved_count
            )

            select_sat_total_both_reachable += (
                both_reachable_count
            )

            select_sat_total_unsupported += (
                unsupported_count
            )

            select_sat_total_solver_errors += (
                solver_error_count
            )


            select_sat_group_details[
                group
            ] = {
                "artifact": str(
                    sat_path
                ),
                "select_count": (
                    select_count
                ),
                "resolved_count": (
                    resolved_count
                ),
                "both_reachable_count": (
                    both_reachable_count
                ),
                "unsupported_count": (
                    unsupported_count
                ),
                "solver_error_count": (
                    solver_error_count
                ),
            }


        if not select_sat_artifacts:

            mark_stage(
                manifest,
                "select_sat",
                "skipped",
                reason=(
                    "no_select_ambiguity"
                ),
                select_count=0,
                resolved_count=0,
                both_reachable_count=0,
                unsupported_count=0,
                solver_error_count=0,
            )

            manifest[
                "artifacts"
            ].pop(
                "select_sat",
                None,
            )

            print(
                "SKIP: no mux-select "
                "ambiguity requires SAT "
                "feasibility analysis"
            )

        else:

            mark_stage(
                manifest,
                "select_sat",
                (
                    "passed"
                    if select_sat_reran
                    else "reused"
                ),
                groups=(
                    select_sat_group_details
                ),
                select_count=(
                    select_sat_total_selectors
                ),
                resolved_count=(
                    select_sat_total_resolved
                ),
                both_reachable_count=(
                    select_sat_total_both_reachable
                ),
                unsupported_count=(
                    select_sat_total_unsupported
                ),
                solver_error_count=(
                    select_sat_total_solver_errors
                ),
                physical_narrowing_applied=False,
            )

            manifest[
                "artifacts"
            ][
                "select_sat"
            ] = {
                group: str(path)
                for group, path
                in select_sat_artifacts.items()
            }


            print(
                "Select SAT summary:"
            )

            print(
                "  Selectors      : "
                f"{select_sat_total_selectors}"
            )

            print(
                "  Resolved       : "
                f"{select_sat_total_resolved}"
            )

            print(
                "  Both reachable : "
                f"{select_sat_total_both_reachable}"
            )

            print(
                "  Unsupported    : "
                f"{select_sat_total_unsupported}"
            )


        write_json_atomic(
            manifest_path,
            manifest,
        )

        # ---------------------------------------------------------------
        # WITNESS — conditional second pass for genuine reconvergence
        # ---------------------------------------------------------------
        stage_banner("WITNESS", "Dynamic branch witnesses -> physical mux-input narrowing")
        witness_total_pending = 0
        witness_total_ambiguous_paths = 0
        witness_groups: Dict[str, Dict[str, Any]] = {}

        for group in groups:
            mapped_doc = read_json(
                mapped_artifacts[group],
                "witness",
            )

            mapped_paths = mapped_doc.get("paths") or []

            witness_total_ambiguous_paths += sum(
                1
                for item in mapped_paths
                if (
                    isinstance(item, dict)
                    and isinstance(item.get("rtl_mapping"), dict)
                    and item["rtl_mapping"].get(
                        "remaining_logical_reconvergence"
                    )
                    is True
                )
            )

            pending = int(
                mapped_doc.get("witness_requests_pending")
                or 0
            )
            if pending > 0:
                request_raw = mapped_doc.get("witness_request")
                request_path = Path(request_raw).resolve() if isinstance(request_raw, str) else mapped_artifacts[group].with_name(
                    mapped_artifacts[group].name.replace("_rtl_mapped.json", "_witness_request.json")
                )
                witness_groups[group] = {"pending": pending, "request": request_path}
                witness_total_pending += pending

        witness_reran = False
        witness_artifacts: Dict[str, Any] = {}
        if witness_total_pending == 0:

            if witness_total_ambiguous_paths > 0:

                mark_stage(
                    manifest,
                    "witness",
                    "skipped",
                    reason=(
                        "ambiguity_present_but_no_executable_witness"
                    ),
                    requests_pending=0,
                    ambiguous_paths=(
                        witness_total_ambiguous_paths
                    ),
                )

                print(
                    "WITNESS BLOCKED: "
                    f"{witness_total_ambiguous_paths} path(s) "
                    "contain genuine logical ambiguity, but the "
                    "current witness protocol could not derive an "
                    "executable physical witness."
                )

            else:

                mark_stage(
                    manifest,
                    "witness",
                    "skipped",
                    reason="no_ambiguity",
                    requests_pending=0,
                    ambiguous_paths=0,
                )

                print(
                    "SKIP: no logical reconvergence requires "
                    "physical witness narrowing"
                )

        else:
            for group, info in witness_groups.items():
                witness_reran = True
                request_path = Path(info["request"])
                if not request_path.is_file():
                    raise PipelineError("witness", f"{group}: witness request not found: {request_path}", group=group)
                witness_subdir = "witness_" + sanitize_report_tag(Path(group + ".rpt"))
                command = [
                    sys.executable,
                    str(scripts["run_stage_reports"]),
                    "--variant", variant,
                    "--design", args.design,
                    "--platform", args.platform,
                    "--stage", timing_stage,
                    "--flow-dir", str(flow_dir),
                    "--tcl-script", str(scripts["report_witness"]),
                    "--report-subdir", witness_subdir,
                    "--env", f"NEBULA_WITNESS_REQUEST={request_path}",
                    "--overwrite",
                ]
                if args.liberty:
                    for lib in args.liberty:
                        command.extend([
                            "--liberty",
                            str(Path(lib).expanduser().resolve()),
                        ])
                elif stage_report_metadata is not None:
                    stage_meta = read_json(stage_report_metadata, "witness")
                    for lib in ((stage_meta.get("source") or {}).get("liberty_files") or []):
                        if isinstance(lib, dict) and isinstance(lib.get("path"), str):
                            command.extend(["--liberty", lib["path"]])
                run_command(command, cwd=flow_dir, stage="witness", group=group, verbose=args.verbose)

                witness_dir = (
                    flow_dir / "reports" / args.platform / args.design / variant /
                    "stages" / timing_stage / witness_subdir
                ).resolve()
                # Keep the request beside its dynamically generated results so
                # narrow_reconvergence.py --witness-dir is self-contained.
                request_copy = witness_dir / request_path.name
                if request_copy.resolve() != request_path.resolve():
                    request_copy.write_bytes(request_path.read_bytes())
                status_files = sorted(witness_dir.glob("witness_*.json"))
                for status_file in status_files:
                    status = read_json(status_file, "witness")
                    witness_id = status.get("witness_id")
                    if not isinstance(witness_id, str) or not witness_id:
                        continue
                    if status.get("resolved") is not True:
                        continue
                    report_path = witness_dir / f"witness_{witness_id}.rpt"
                    if not report_path.is_file():
                        raise PipelineError("witness", f"{group}: resolved witness has no report: {report_path}", group=group)
                    parsed_path = witness_dir / f"witness_{witness_id}_timing.json"
                    parse_command = [
                        sys.executable,
                        str(scripts["parse_timing"]),
                        "--variant", variant,
                        "--design", args.design,
                        "--platform", args.platform,
                        "--flow-dir", str(flow_dir),
                        "--report", str(report_path),
                        "--output", str(parsed_path),
                    ]
                    run_command(parse_command, cwd=flow_dir, stage="witness", group=group, verbose=args.verbose)

                # Re-run the mapper against exactly the same timing paths and RTL graph,
                # now with physical witness timing available.
                remap_command = [
                    sys.executable,
                    str(scripts["map_to_rtl"]),
                    "--variant", variant,
                    "--design", args.design,
                    "--top", rtl_top,
                    "--platform", args.platform,
                    "--flow-dir", str(flow_dir),
                    "--timing-json", str(timing_artifacts[group]),
                    "--rtl-graph", str(rtl_graph_path),
                    "--witness-dir", str(witness_dir),
                    "--output", str(mapped_artifacts[group]),
                ]
                run_command(remap_command, cwd=flow_dir, stage="witness", group=group, verbose=args.verbose)
                remapped = validate_mapping(
                    mapped_artifacts[group], timing_artifacts[group], args.design,
                    args.platform, variant, group, allow_pending_witness=False,
                )
                resolved_count = int(remapped.get("witness_resolved_path_count") or 0)
                witness_artifacts[group] = {
                    "request": str(request_path),
                    "directory": str(witness_dir),
                    "resolved_paths": resolved_count,
                }

            mark_stage(
                manifest,
                "witness",
                "passed",
                requests_pending=witness_total_pending,
                groups=witness_artifacts,
            )
            manifest["artifacts"]["witness"] = witness_artifacts

        write_json_atomic(manifest_path, manifest)

        # ---------------------------------------------------------------
        # CLASSIFICATION
        # ---------------------------------------------------------------
        stage_banner("CLASSIFICATION", "Resolved RTL structure -> bottleneck class/pattern")
        classified_artifacts: Dict[str, Path] = {}
        classified_counts: Dict[str, int] = {}
        classification_blocked_counts: Dict[str, int] = {}
        classification_reran = False

        for group in groups:
            mapped_path = mapped_artifacts[group]
            classified_path = classified_output_for(ai_runs, variant, group)
            classified_artifacts[group] = classified_path
            needs_run = (
                not args.resume
                or mapping_reran
                or witness_reran
                or force_applies(args.force_stage, "classification")
                or not artifact_fresh(
                    classified_path,
                    [mapped_path, scripts["classify_path"]],
                )
            )
            if needs_run:
                classification_reran = True
                print(f"\nClassifying group: {group}")
                command = [
                    sys.executable,
                    str(scripts["classify_path"]),
                    "--mapped-json", str(mapped_path),
                    "--flow-dir", str(flow_dir),
                    "--output", str(classified_path),
                ]
                run_command(
                    command,
                    cwd=flow_dir,
                    stage="classification",
                    group=group,
                    verbose=args.verbose,
                )
            else:
                print(f"REUSE {group}: {classified_path.name}")

            classified = validate_classification(
                classified_path,
                mapped_path,
                args.design,
                args.platform,
                variant,
                group,
            )
            classified_counts[group] = len(classified["paths"])

            classification_blocked_counts[group] = sum(
                1
                for item in classified["paths"]
                if (
                    isinstance(item, dict)
                    and isinstance(item.get("classification"), dict)
                    and item["classification"].get("status")
                    == "needs_physical_narrowing"
                )
            )

        mark_stage(
            manifest,
            "classification",
            "passed" if classification_reran else "reused",
            groups=groups,
            classified_counts=classified_counts,
            total_classified=sum(classified_counts.values()),
            needs_physical_narrowing_counts=classification_blocked_counts,
            total_needs_physical_narrowing=sum(
                classification_blocked_counts.values()
            ),
        )
        manifest["artifacts"]["classified"] = {
            g: str(p) for g, p in classified_artifacts.items()
        }
        write_json_atomic(manifest_path, manifest)

        # ---------------------------------------------------------------
        # FINAL TRUST BOUNDARY
        # ---------------------------------------------------------------

        # Re-check after mapping/classification. If RTL/config/SDC/report
        # inputs changed while Python analysis was running, fail instead of
        # producing a mixed-provenance optimizer packet.
        flow_integrity_before_builder = (
            verify_current_flow_inputs(
                script_dir=script_dir,
                run_info=run_info,
                design=args.design,
                platform=args.platform,
                phase="before_optimizer_input",
            )
        )

        manifest[
            "stages"
        ][
            "flow"
        ][
            "flow_input_integrity_before_optimizer_input"
        ] = flow_integrity_before_builder

        write_json_atomic(
            manifest_path,
            manifest,
        )

        unresolved_physical_paths = sum(
            classification_blocked_counts.values()
        )

        if unresolved_physical_paths > 0:

            stage_banner(
                "OPTIMIZER INPUT",
                "Blocked: unresolved physical narrowing",
            )

            print(
                "Optimizer input will not be built because "
                f"{unresolved_physical_paths} classified timing path(s) "
                "still require physical narrowing."
            )

            for group, count in sorted(
                classification_blocked_counts.items()
            ):
                if count:
                    print(
                        f"  {group}: "
                        f"{count} path(s) need physical narrowing"
                    )

            mark_stage(
                manifest,
                "optimizer_input",
                "skipped",
                reason="unresolved_physical_narrowing",
                blocked=True,
                optimizer_ready=False,
                unresolved_path_count=unresolved_physical_paths,
                unresolved_counts=classification_blocked_counts,
            )

            # Never advertise or consume an optimizer packet from a run whose
            # current classification is unresolved.  An old packet may remain
            # on disk for forensics, but it is not a trusted artifact of this
            # pipeline state.
            manifest["artifacts"].pop(
                "optimizer_input",
                None,
            )

            manifest["final"] = {
                "analysis_complete": True,
                "optimizer_ready": False,
                "optimizer_input": None,
                "optimizer_blocked_reason": (
                    "unresolved_physical_narrowing"
                ),
                "unresolved_physical_path_count": (
                    unresolved_physical_paths
                ),
                "unresolved_physical_path_counts": (
                    classification_blocked_counts
                ),
                "flow_input_integrity_verified": True,
                "flow_input_aggregate_sha256": (
                    flow_integrity_before_builder.get(
                        "aggregate_sha256"
                    )
                ),
                "diagnostic_region_count": 0,
                "optimization_unit_count": 0,
                "optimization_ready_unit_count": 0,
            }

            manifest["status"] = "passed"
            manifest["completed_at"] = utc_now()

            write_json_atomic(
                manifest_path,
                manifest,
            )

            print()
            print("=" * 72)
            print("RTL ANALYSIS PIPELINE COMPLETE")
            print("=" * 72)
            print(f"Design        : {args.design}")
            print(f"Platform      : {args.platform}")
            print(f"Flow Variant  : {variant}")
            print()
            print("Analysis")
            print("-" * 72)
            print(
                f"Timing paths  : "
                f"{sum(classified_counts.values())}"
            )
            print(
                f"Need physical narrowing : "
                f"{unresolved_physical_paths}"
            )
            print()
            print("Optimization")
            print("-" * 72)
            print("Optimizer input : BLOCKED")
            print(
                "Reason          : unresolved physical narrowing"
            )
            print()
            print("OPTIMIZER READY : NO")
            print(
                f"Pipeline manifest: {manifest_path}"
            )
            print("=" * 72)

            return 0

        stage_banner("OPTIMIZER INPUT", "Final trust boundary")

        # build_optimizer_input.py intentionally discovers all variant-scoped
        # artifacts. Protect that trust boundary from stale/manual groups.
        assert_no_unselected_group_artifacts(
            ai_runs,
            variant,
            groups,
        )

        optimizer_input = ai_runs / f"{variant}_optimizer_input.json"
        builder_inputs: List[Path] = [
            scripts["build_optimizer_input"],
            run_manifest_path,
            metrics_path,
            rtl_graph_path,
            *timing_artifacts.values(),
            *mapped_artifacts.values(),
            *classified_artifacts.values(),
        ]
        needs_builder = (
            not args.resume
            or classification_reran
            or force_applies(args.force_stage, "optimizer_input")
            or not artifact_fresh(optimizer_input, builder_inputs)
        )
        if needs_builder:
            command = [
                sys.executable,
                str(scripts["build_optimizer_input"]),
                "--flow-variant", variant,
                "--ai-runs-dir", str(ai_runs),
                "--metrics-json", str(metrics_path),
                "--output", str(optimizer_input),
                "--context-lines", str(args.context_lines),
                "--minimum-confidence", args.minimum_confidence,
                "--wns-tolerance-ns", str(args.wns_tolerance_ns),
                "--no-auto-classify",
            ]
            if args.allow_latency_change:
                command.append("--allow-latency-change")
            if args.allow_pipeline:
                command.append("--allow-pipeline")
            if args.allow_retiming:
                command.append("--allow-retiming")

            run_command(
                command,
                cwd=flow_dir,
                stage="optimizer_input",
                verbose=args.verbose,
            )
            builder_status = "passed"
        else:
            print(f"REUSE: {optimizer_input.name}")
            builder_status = "reused"

        packet = validate_optimizer_input(
            optimizer_input,
            args.design,
            args.platform,
            variant,
        )

        # Last gate: prove the physical-run inputs still match immediately
        # before declaring the packet optimizer-ready.
        flow_integrity_final = (
            verify_current_flow_inputs(
                script_dir=script_dir,
                run_info=run_info,
                design=args.design,
                platform=args.platform,
                phase="final_optimizer_ready_gate",
            )
        )

        manifest[
            "stages"
        ][
            "flow"
        ][
            "flow_input_integrity_final"
        ] = flow_integrity_final

        summary = packet.get("summary") or {}
        validation = packet.get("validation") or {}
        mark_stage(
            manifest,
            "optimizer_input",
            builder_status,
            output=str(optimizer_input),
            optimizer_ready=True,
            validation_checks=validation.get("checks"),
            summary=summary,
        )
        manifest["artifacts"]["optimizer_input"] = str(optimizer_input)
        manifest["final"] = {
            "optimizer_ready": True,
            "optimizer_input": str(optimizer_input),
            "flow_input_integrity_verified": True,
            "flow_input_aggregate_sha256": (
                flow_integrity_final.get(
                    "aggregate_sha256"
                )
            ),
            "diagnostic_region_count": summary.get("diagnostic_region_count"),
            "optimization_unit_count": summary.get("optimization_unit_count"),
            "optimization_ready_unit_count": summary.get("optimization_ready_unit_count"),
        }
        manifest["status"] = "passed"
        manifest["completed_at"] = utc_now()
        write_json_atomic(manifest_path, manifest)

        print_success_summary(packet, manifest_path)
        return 0

    except PipelineError as exc:
        manifest["status"] = "failed"
        manifest["completed_at"] = utc_now()
        manifest["final"] = {
            "optimizer_ready": False,
            "failed_stage": exc.stage,
            "failed_group": exc.group,
            "reason": str(exc),
            "command": exc.command,
        }
        mark_stage(
            manifest,
            exc.stage,
            "failed",
            group=exc.group,
            reason=str(exc),
            command=exc.command,
        )

        if manifest_path is None and manifest.get("flow_variant"):
            manifest_path = ai_runs / f"{manifest['flow_variant']}_pipeline.json"
        if manifest_path is not None:
            try:
                write_json_atomic(manifest_path, manifest)
            except Exception:
                pass

        print()
        print("=" * 72)
        print("ANALYSIS PIPELINE FAILED")
        print("=" * 72)
        print(f"Stage : {exc.stage}")
        if exc.group:
            print(f"Group : {exc.group}")
        print()
        print("Reason:")
        print(f"  {exc}")
        if exc.command:
            print()
            print("Command:")
            print("  " + " ".join(str(x) for x in exc.command))
        if manifest_path is not None:
            print()
            print(f"Pipeline manifest: {manifest_path}")
        print("=" * 72)

        if args.verbose:
            traceback.print_exc()
        return 2

    except Exception as exc:
        manifest["status"] = "failed"
        manifest["completed_at"] = utc_now()
        manifest["final"] = {
            "optimizer_ready": False,
            "failed_stage": "internal",
            "reason": repr(exc),
        }
        if manifest_path is not None:
            try:
                write_json_atomic(manifest_path, manifest)
            except Exception:
                pass
        print()
        print("=" * 72)
        print("ANALYSIS PIPELINE FAILED")
        print("=" * 72)
        print("Stage : internal")
        print(f"Reason: {exc}")
        print("=" * 72)
        if args.verbose:
            traceback.print_exc()
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
