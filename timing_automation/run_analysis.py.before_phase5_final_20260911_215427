def run_fresh_flow(
    script_dir: Path,
    design: str,
    platform: str,
    prefix: str,
) -> Dict[str, Any]:
    """Import run_flow.py so the generated variant is returned without stdout parsing."""
    sys.path.insert(0, str(script_dir))
    try:
        from run_flow import run_flow  # type: ignore
    except Exception as exc:
        raise PipelineError("flow", f"Could not import run_flow.py: {exc}")

    try:
        info = run_flow(
            design=design,
            platform=platform,
            prefix=prefix,
        )
    except Exception as exc:
        raise PipelineError("flow", str(exc))

    if not isinstance(info, dict) or not info.get("flow_variant"):
        raise PipelineError("flow", "run_flow.py did not return a valid run manifest")
    return info


def load_resume_run(
    ai_runs: Path,
    design: str,
    platform: str,
    variant: str,
) -> Dict[str, Any]:
    manifest_path = ai_runs / f"{variant}.json"
    info = read_json(manifest_path, "flow")
    ensure_context(
        info,
        design=design,
        platform=platform,
        variant=variant,
        path=manifest_path,
        stage="flow",
    )
    for key in ("report_dir", "result_dir", "log_dir", "object_dir"):
        if not info.get(key):
            raise PipelineError("flow", f"Run manifest missing {key}: {manifest_path}")
    return info


def timing_output_for(ai_runs: Path, variant: str, report: Path) -> Tuple[str, Path]:
    tag = sanitize_report_tag(report)
    return tag, ai_runs / f"{variant}_{tag}_timing_paths.json"


def mapped_output_for(ai_runs: Path, variant: str, group: str) -> Path:
    return ai_runs / f"{variant}_{group}_rtl_mapped.json"


def classified_output_for(ai_runs: Path, variant: str, group: str) -> Path:
    return ai_runs / f"{variant}_{group}_classified.json"


def existing_artifact_groups(ai_runs: Path, variant: str, suffix: str) -> set[str]:
    prefix = variant + "_"
    groups: set[str] = set()
    for path in ai_runs.glob(f"{variant}_*{suffix}"):
        name = path.name
        if not name.startswith(prefix) or not name.endswith(suffix):
            continue
        middle = name[len(prefix): -len(suffix)]
        if middle:
            groups.add(middle)
    return groups


def assert_no_unselected_group_artifacts(
    ai_runs: Path,
    variant: str,
    selected_groups: Sequence[str],
) -> None:
    selected = set(selected_groups)
    existing = set()
    for suffix in (
        "_timing_paths.json",
        "_rtl_mapped.json",
        "_classified.json",
    ):
        existing |= existing_artifact_groups(ai_runs, variant, suffix)

    extras = sorted(existing - selected)
    if extras:
        raise PipelineError(
            "optimizer_input",
            "Found variant-scoped path-group artifacts that are not part of "
            "this pipeline run: " + ", ".join(extras) + ". "
            "Refusing to let build_optimizer_input.py silently ingest stale or "
            "diagnostic groups. Move/delete those extra *_timing_paths.json / "
            "*_rtl_mapped.json / *_classified.json files for this variant, or "
            "explicitly include the corresponding reports in the analysis policy.",
        )


def packet_has_cryptographic_source_integrity(packet: Dict[str, Any]) -> bool:
    paths = packet.get("critical_paths")
    if not isinstance(paths, list) or not paths:
        return False
    seen = False
    for path in paths:
        if not isinstance(path, dict):
            return False
        mapping = path.get("rtl_mapping") or {}
        locations = mapping.get("source_locations") or []
        if not locations:
            return False
        for loc in locations:
            integrity = (loc or {}).get("integrity") or {}
            seen = True
            if integrity.get("freshness_assurance") != "cryptographic":
                return False
            if integrity.get("upstream_hash_matches_current_source") is not True:
                return False
    return seen


