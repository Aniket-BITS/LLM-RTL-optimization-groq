def validate_metrics(
    path: Path,
    design: str,
    platform: str,
    variant: str,
) -> Dict[str, Any]:
    data = read_json(path, "metrics")
    ensure_context(
        data,
        design=design,
        platform=platform,
        variant=variant,
        path=path,
        stage="metrics",
    )

    metrics = data.get("metrics")
    if not isinstance(metrics, dict):
        raise PipelineError("metrics", f"{path.name}: missing metrics object")

    canonical_metric_keys = (
        "wns_ns",
        "tns_ns",
        "area_um2",
        "power_mw",
    )
    missing = [
        key
        for key in canonical_metric_keys
        if metrics.get(key) is None
    ]
    if missing:
        raise PipelineError(
            "metrics",
            f"{path.name}: missing required canonical metrics: {', '.join(missing)}",
        )

    if data.get("flow_complete") is False:
        raise PipelineError(
            "metrics",
            f"{path.name}: collect_metrics marked flow_complete=false",
        )
    return data


def validate_timing(
    path: Path,
    design: str,
    platform: str,
    variant: str,
) -> Dict[str, Any]:
    data = read_json(path, "timing")
    ensure_context(
        data,
        design=design,
        platform=platform,
        variant=variant,
        path=path,
        stage="timing",
    )
    paths = data.get("paths")
    if not isinstance(paths, list) or not paths:
        raise PipelineError("timing", f"{path.name}: no timing paths were parsed")
    for idx, item in enumerate(paths):
        if not isinstance(item, dict):
            raise PipelineError("timing", f"{path.name}: path {idx} is not an object")
        for key in ("startpoint", "endpoint", "slack_ns"):
            if item.get(key) is None:
                raise PipelineError(
                    "timing",
                    f"{path.name}: path {idx} missing {key}",
                )
    return data


def validate_mapping(
    mapped_path: Path,
    timing_path: Path,
    design: str,
    platform: str,
    variant: str,
    group: str,
    *,
    allow_pending_witness: bool = False,
) -> Dict[str, Any]:
    mapped = read_json(mapped_path, "mapping")
    timing = read_json(timing_path, "mapping")
    ensure_context(
        mapped,
        design=design,
        platform=platform,
        variant=variant,
        path=mapped_path,
        stage="mapping",
    )

    mapped_paths = mapped.get("paths")
    timing_paths = timing.get("paths")
    if not isinstance(mapped_paths, list) or not isinstance(timing_paths, list):
        raise PipelineError("mapping", f"{group}: missing paths lists", group=group)
    if len(mapped_paths) != len(timing_paths):
        raise PipelineError(
            "mapping",
            f"{group}: timing path count {len(timing_paths)} != mapped path count {len(mapped_paths)}",
            group=group,
        )

    failures: List[str] = []
    ambiguous = 0
    for idx, item in enumerate(mapped_paths):
        mapping = item.get("rtl_mapping") if isinstance(item, dict) else None
        if not isinstance(mapping, dict):
            failures.append(f"path {idx}: missing rtl_mapping")
            continue
        if mapping.get("status") != "mapped":
            failures.append(f"path {idx}: mapping status={mapping.get('status')!r}")
        if not mapping.get("has_user_rtl_source"):
            failures.append(f"path {idx}: no user RTL source")

        # map_to_rtl schema v5 hashing is now part of the trust contract.
        integrity = mapping.get("source_integrity")
        if not isinstance(integrity, dict) or integrity.get("status") != "complete":
            failures.append(f"path {idx}: mapping-time source SHA-256 provenance incomplete")

        if mapping.get("remaining_logical_reconvergence"):
            narrowing = mapping.get("physical_narrowing") or {}
            if not (isinstance(narrowing, dict) and narrowing.get("resolved") is True):
                ambiguous += 1

    if failures:
        preview = "\n  ".join(failures[:10])
        extra = "" if len(failures) <= 10 else f"\n  ... {len(failures)-10} more"
        raise PipelineError(
            "mapping",
            f"{group}: mapping validation failed:\n  {preview}{extra}",
            group=group,
        )

    if ambiguous and not allow_pending_witness:
        raise PipelineError(
            "mapping",
            f"{group}: {ambiguous} path(s) still require physical witness narrowing. "
            "The two-pass witness stage did not resolve them; classification is blocked.",
            group=group,
        )

    return mapped


def validate_classification(
    classified_path: Path,
    mapped_path: Path,
    design: str,
    platform: str,
    variant: str,
    group: str,
) -> Dict[str, Any]:
    classified = read_json(classified_path, "classification")
    mapped = read_json(mapped_path, "classification")
    ensure_context(
        classified,
        design=design,
        platform=platform,
        variant=variant,
        path=classified_path,
        stage="classification",
    )

    cp = classified.get("paths")
    mp = mapped.get("paths")
    if not isinstance(cp, list) or not isinstance(mp, list):
        raise PipelineError("classification", f"{group}: missing paths lists", group=group)
    if len(cp) != len(mp):
        raise PipelineError(
            "classification",
            f"{group}: mapped path count {len(mp)} != classified path count {len(cp)}",
            group=group,
        )

    failures: List[str] = []
    for idx, item in enumerate(cp):
        cls = item.get("classification") if isinstance(item, dict) else None
        if not isinstance(cls, dict):
            failures.append(f"path {idx}: missing classification")
            continue
        status = cls.get("status")

        if status == "classified":
            pass

        elif status == "needs_physical_narrowing":

            resolution = cls.get("resolution") or {}

            if (
                resolution.get("status")
                != "unresolved_reconvergence"
            ):
                failures.append(
                    f"path {idx}: needs_physical_narrowing without "
                    "resolution.status='unresolved_reconvergence'"
                )

            if (
                cls.get("remaining_logical_reconvergence")
                is not True
            ):
                failures.append(
                    f"path {idx}: needs_physical_narrowing without "
                    "remaining_logical_reconvergence=true"
                )

        else:
            failures.append(
                f"path {idx}: classification status={status!r}"
            )

        if not cls.get("structural_class"):
            failures.append(
                f"path {idx}: missing structural_class"
            )

        if not cls.get("structural_pattern"):
            failures.append(
                f"path {idx}: missing structural_pattern"
            )

    if failures:
        preview = "\n  ".join(failures[:10])
        extra = "" if len(failures) <= 10 else f"\n  ... {len(failures)-10} more"
        raise PipelineError(
            "classification",
            f"{group}: classification validation failed:\n  {preview}{extra}",
            group=group,
        )
    return classified


def validate_optimizer_input(
    path: Path,
    design: str,
    platform: str,
    variant: str,
) -> Dict[str, Any]:
    data = read_json(path, "optimizer_input")
    ensure_context(
        data,
        design=design,
        platform=platform,
        variant=variant,
        path=path,
        stage="optimizer_input",
    )

    validation = data.get("validation")
    if not isinstance(validation, dict):
        raise PipelineError("optimizer_input", f"{path.name}: missing validation object")

    if validation.get("optimizer_ready") is not True:
        errors = validation.get("fatal_errors") or []
        message = "Builder completed but optimizer_ready is false"
        if errors:
            message += ":\n  " + "\n  ".join(str(x) for x in errors)
        raise PipelineError("optimizer_input", message)

    units = data.get("optimization_units")
    if not isinstance(units, list) or not units:
        raise PipelineError(
            "optimizer_input",
            f"{path.name}: optimizer_ready=true but no optimization_units exist",
        )
    if not any(
        isinstance(u, dict)
        and isinstance(u.get("eligibility"), dict)
        and u["eligibility"].get("optimization_ready") is True
        for u in units
    ):
        raise PipelineError(
            "optimizer_input",
            f"{path.name}: no optimization-ready unit exists",
        )
    return data


