{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebula.local/schemas/optimizer_response_latency.schema.json",
  "title": "nEBULA Latency-Aware Optimizer Response 3.3",
  "description": "One latency-aware optimizer decision with explicit transformation intent. The LLM chooses editing base and intended transformations; backend owns identity, structural observations, formal truth, verified latency, duplicate truth, and promotion.",
  "oneOf": [
    {
      "$ref": "#/$defs/candidate_response"
    },
    {
      "$ref": "#/$defs/stop_response"
    }
  ],
  "$defs": {
    "candidate_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision",
        "editing_base",
        "primary_transformation",
        "proposed_transformations",
        "chosen_pattern_id",
        "target_unit_id",
        "source_files",
        "rationale",
        "predicted_wns_gain_ns",
        "predicted_area_change_pct",
        "predicted_power_change_pct",
        "predicted_latency_change_cycles",
        "sequential_changes",
        "self_checks"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "3.3"
        },
        "decision": {
          "type": "string",
          "const": "propose_candidate"
        },
        "editing_base": {
          "type": "string",
          "enum": [
            "golden",
            "current_best"
          ],
          "description": "Construction/materialization base only. Formal remains against Golden and PPA remains against Current Best."
        },
        "primary_transformation": {
          "type": "string",
          "enum": [
            "pipeline_insertion",
            "register_retiming",
            "logic_restructuring",
            "mux_restructuring",
            "arithmetic_restructuring",
            "fsm_reencoding",
            "fsm_restructuring",
            "constant_optimization",
            "resource_sharing",
            "custom"
          ],
          "description": "Advisory primary transformation intent. Backend-observed structural effects and verified latency are authoritative."
        },
        "proposed_transformations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pipeline_insertion",
              "register_retiming",
              "logic_restructuring",
              "mux_restructuring",
              "arithmetic_restructuring",
              "fsm_reencoding",
              "fsm_restructuring",
              "constant_optimization",
              "resource_sharing",
              "custom"
            ]
          },
          "description": "Advisory set of concrete transformations attempted. Avoid vague mixed labels."
        },
        "chosen_pattern_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Advisory pattern/family label."
        },
        "target_unit_id": {
          "type": "string",
          "const": "whole_design",
          "description": "Diagnostic whole-design unit; never an edit boundary."
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "predicted_wns_gain_ns": {
          "type": [
            "number",
            "null"
          ]
        },
        "predicted_area_change_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "predicted_power_change_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "predicted_latency_change_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Advisory prediction relative to the unchanged Current Best. Backend independently proves total latency relative to frozen Golden."
        },
        "sequential_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequential_change"
          }
        },
        "self_checks": {
          "$ref": "#/$defs/self_checks"
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "description": "Every source file in the selected editing base exactly once, with complete candidate text. No new/omitted files in this phase.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_file",
              "verilog"
            ],
            "properties": {
              "target_file": {
                "type": "string",
                "minLength": 1
              },
              "verilog": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "stop_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision",
        "rationale"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "3.3"
        },
        "decision": {
          "type": "string",
          "const": "no_further_optimization"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sequential_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clock_domain",
        "rationale"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pipeline_register",
            "retimed_register",
            "fsm_state_change",
            "other_intentional_state"
          ]
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_unchanged",
        "parameters_unchanged",
        "latency_policy_considered",
        "clock_reset_behavior_unchanged",
        "uses_only_permitted_clock_reset_domains",
        "intentional_sequential_changes_declared",
        "source_bundle_targets_valid",
        "no_new_latches",
        "no_new_clock_domains"
      ],
      "properties": {
        "interface_unchanged": {
          "type": "boolean"
        },
        "parameters_unchanged": {
          "type": "boolean"
        },
        "latency_policy_considered": {
          "type": "boolean"
        },
        "latency_unchanged": {
          "type": "boolean"
        },
        "clock_reset_behavior_unchanged": {
          "type": "boolean"
        },
        "uses_only_permitted_clock_reset_domains": {
          "type": "boolean"
        },
        "intentional_sequential_changes_declared": {
          "type": "boolean"
        },
        "source_bundle_targets_valid": {
          "type": "boolean"
        },
        "no_new_latches": {
          "type": "boolean"
        },
        "no_new_clock_domains": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Advisory model self-assessment only; backend verification is authoritative."
    }
  },
  "$comment": "Latency-aware complete-source schema. Model latency predictions/self-checks are advisory. Backend independently proves the temporal relation."
}
