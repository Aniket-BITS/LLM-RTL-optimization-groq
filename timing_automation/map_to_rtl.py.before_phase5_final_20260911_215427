def parse_source(
    raw: str,
    flow_dir: Path,
    rtl_roots: Sequence[Path],
    source_hasher: SourceHashCache,
) -> Dict[str, Any]:

    match = SRC_RE.match(
        str(raw).strip()
    )


    if not match:

        return {
            "raw": raw,
            "source_type": "unknown",
        }


    filename = match.group(
        "file"
    )

    start = int(
        match.group(
            "start"
        )
    )

    end = int(
        match.group(
            "end"
        )
        or start
    )


    source_path = Path(
        filename
    )


    if source_path.is_absolute():

        candidates = [
            source_path
        ]

    else:

        candidates = [
            flow_dir
            / source_path,

            flow_dir.parent
            / source_path,

            Path.cwd()
            / source_path,
        ]

        for root in rtl_roots:

            candidates.append(
                root
                / source_path.name
            )


    resolved = None


    for candidate in candidates:

        try:

            if candidate.exists():

                resolved = (
                    candidate.resolve()
                )

                break

        except OSError:
            pass


    source_type = (
        "external_or_generated"
    )


    if resolved:

        for root in rtl_roots:

            try:

                resolved.relative_to(
                    root.resolve()
                )

                source_type = (
                    "user_rtl"
                )

                break

            except ValueError:
                pass


    raw_norm = filename.replace(
        "\\",
        "/",
    )


    if (
        "/designs/src/"
        in "/" + raw_norm
    ):

        source_type = (
            "user_rtl"
        )


    source_integrity = None


    if source_type == "user_rtl":

        if resolved is None:

            raise RuntimeError(
                "Mapped USER RTL source could not be resolved for hashing: "
                f"{filename}"
            )


        source_integrity = source_hasher.describe(
            resolved
        )


    return {
        "raw": raw,
        "file": filename,
        "resolved_file": (
            str(resolved)
            if resolved
            else None
        ),
        "start_line": start,
        "end_line": end,
        "source_type": source_type,
        "sha256": (
            source_integrity.get("sha256")
            if source_integrity
            else None
        ),
        "source_integrity": source_integrity,
    }


def serialize_cell(
    name: str,
    cell: Dict[str, Any],
    flow_dir: Path,
    rtl_roots: Sequence[Path],
    source_hasher: SourceHashCache,
) -> Dict[str, Any]:

    return {
        "name": name,
        "type": cell.get(
            "type"
        ),
        "input_bits": cell.get(
            "input_bits",
            [],
        ),
        "output_bits": cell.get(
            "output_bits",
            [],
        ),
        "sources": [
            parse_source(
                raw,
                flow_dir,
                rtl_roots,
                source_hasher,
            )
            for raw in cell.get(
                "src",
                [],
            )
        ],
    }


def rtl_regions(
    cells: Sequence[
        Dict[str, Any]
    ],
) -> List[
    Dict[str, Any]
]:

    regions = {}


    for cell in cells:

        for source in cell.get(
            "sources",
            [],
        ):

            if source.get(
                "source_type"
            ) != "user_rtl":

                continue


            filename = (
                source.get(
                    "resolved_file"
                )
                or source.get(
                    "file"
                )
            )

            start = source.get(
                "start_line"
            )

            end = (
                source.get(
                    "end_line"
                )
                or start
            )


            if (
                not filename
                or start is None
            ):
                continue


            key = (
                str(filename),
                int(start),
                int(end),
            )


            if key not in regions:

                regions[key] = {
                    "file": filename,
                    "sha256": source.get(
                        "sha256"
                    ),
                    "hash_algorithm": (
                        "sha256"
                        if source.get("sha256")
                        else None
                    ),
                    "start_line": int(
                        start
                    ),
                    "end_line": int(
                        end
                    ),
                    "cell_count": 0,
                    "operators": Counter(),
                    "cells": [],
                }


            item = regions[
                key
            ]

            item[
                "cell_count"
            ] += 1

            item[
                "operators"
            ][
                cell.get(
                    "type"
                )
            ] += 1

            item[
                "cells"
            ].append(
                cell.get(
                    "name"
                )
            )


    output = []


    for item in regions.values():

        item[
            "operators"
        ] = dict(
            item[
                "operators"
            ]
        )

        item[
            "cells"
        ] = sorted(
            set(
                item[
                    "cells"
                ]
            )
        )

        output.append(
            item
        )


    output.sort(
        key=lambda item: (
            item[
                "cell_count"
            ],
            -item[
                "start_line"
            ],
        ),
        reverse=True,
    )


    return output


