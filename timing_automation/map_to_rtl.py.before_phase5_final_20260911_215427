def aliases(
    signal: Optional[str],
    design: str,
) -> List[str]:

    signal = reg_signal(signal)

    if not signal:
        return []

    result = {
        signal,
        signal.replace(
            "/",
            ".",
        ),
        signal.replace(
            ".",
            "/",
        ),
    }

    for sep in (
        "/",
        ".",
    ):

        prefix = (
            f"{design}{sep}"
        )

        if signal.startswith(
            prefix
        ):
            result.add(
                signal[
                    len(prefix):
                ]
            )

    return sorted(result)


class RTLGraphIndex:

    def __init__(
        self,
        graph: Dict[str, Any],
        design: str,
    ):

        self.graph = graph
        self.design = design

        self.cells: Dict[
            str,
            Dict[str, Any],
        ] = (
            graph.get("cells")
            or {}
        )

        self.signal_bits: Dict[
            str,
            List[Any],
        ] = (
            graph.get("signal_bits")
            or {}
        )

        self.bit_names: Dict[
            str,
            List[str],
        ] = (
            graph.get("bit_names")
            or {}
        )

        self.ports: Dict[
            str,
            Dict[str, Any],
        ] = (
            graph.get("ports")
            or {}
        )

        self.primary_input_bits: Set[int] = set()
        self.primary_output_bits: Set[int] = set()

        for port in self.ports.values():

            direction = str(
                port.get("direction")
                or ""
            ).lower()

            for raw in (
                port.get("bits")
                or []
            ):

                value = bit_id(raw)

                if value is None:
                    continue

                if direction in (
                    "input",
                    "inout",
                ):
                    self.primary_input_bits.add(
                        value
                    )

                if direction in (
                    "output",
                    "inout",
                ):
                    self.primary_output_bits.add(
                        value
                    )

        self.consumers: Dict[
            int,
            Set[str],
        ] = defaultdict(set)

        self.drivers: Dict[
            int,
            Set[str],
        ] = defaultdict(set)

        self.q_to_seq: Dict[
            int,
            List[Tuple[str, int]],
        ] = defaultdict(list)


        for name, cell in self.cells.items():

            # Sequential cells are boundaries.
            if cell.get(
                "sequential"
            ):

                q = find_port(
                    cell,
                    "Q",
                )

                if q:

                    q_bits = conns(
                        cell
                    ).get(
                        q,
                        [],
                    )

                    for index, raw in enumerate(
                        q_bits
                    ):

                        value = bit_id(
                            raw
                        )

                        if value is not None:

                            self.q_to_seq[
                                value
                            ].append(
                                (
                                    name,
                                    index,
                                )
                            )

                continue


            for raw in cell.get(
                "input_bits",
                [],
            ):

                value = bit_id(
                    raw
                )

                if value is not None:

                    self.consumers[
                        value
                    ].add(
                        name
                    )


            for raw in cell.get(
                "output_bits",
                [],
            ):

                value = bit_id(
                    raw
                )

                if value is not None:

                    self.drivers[
                        value
                    ].add(
                        name
                    )


    def is_primary_input(
        self,
        bit: int,
    ) -> bool:

        return (
            int(bit)
            in self.primary_input_bits
        )


    def is_primary_output(
        self,
        bit: int,
    ) -> bool:

        return (
            int(bit)
            in self.primary_output_bits
        )


    def resolve(
        self,
        signal: Optional[str],
    ) -> Dict[str, Any]:

        matches: List[
            Tuple[str, int]
        ] = []

        for name in aliases(
            signal,
            self.design,
        ):

            bits = self.signal_bits.get(
                name
            )

            if (
                bits is None
                or len(bits) != 1
            ):
                continue

            value = bit_id(
                bits[0]
            )

            if value is not None:

                matches.append(
                    (
                        name,
                        value,
                    )
                )


        unique = sorted(
            {
                value
                for _, value
                in matches
            }
        )


        if len(unique) == 1:

            value = unique[0]

            return {
                "status": "resolved",
                "requested": reg_signal(
                    signal
                ),
                "matched_names": sorted(
                    name
                    for name, bit
                    in matches
                    if bit == value
                ),
                "bit": value,
                "bit_names": (
                    self.bit_names.get(
                        str(value),
                        [],
                    )
                ),
            }


        if len(unique) > 1:

            return {
                "status": "ambiguous",
                "requested": reg_signal(
                    signal
                ),
                "candidates": [
                    {
                        "name": name,
                        "bit": value,
                    }
                    for name, value
                    in matches
                ],
            }


        return {
            "status": "not_found",
            "requested": reg_signal(
                signal
            ),
        }


    def capture_d(
        self,
        q_bit: int,
    ) -> Dict[str, Any]:

        candidates = []


        for name, q_index in self.q_to_seq.get(
            q_bit,
            [],
        ):

            cell = self.cells[
                name
            ]

            q = find_port(
                cell,
                "Q",
            )

            d = find_port(
                cell,
                "D",
                "AD",
            )

            if not q or not d:
                continue


            q_bits = conns(
                cell
            ).get(
                q,
                [],
            )

            d_bits = conns(
                cell
            ).get(
                d,
                [],
            )


            if (
                q_index >= len(q_bits)
                or q_index >= len(d_bits)
            ):
                continue


            d_bit = bit_id(
                d_bits[
                    q_index
                ]
            )

            if d_bit is None:
                continue


            candidates.append(
                {
                    "cell": name,
                    "cell_type": cell.get(
                        "type"
                    ),
                    "q_bit": q_bit,
                    "d_bit": d_bit,
                    "src": cell.get(
                        "src",
                        [],
                    ),
                }
            )


        unique = {
            (
                item["cell"],
                item["d_bit"],
            ): item

            for item in candidates
        }

        candidates = list(
            unique.values()
        )


        if len(candidates) == 1:

            return {
                "status": "resolved",
                **candidates[0],
            }


        if len(candidates) > 1:

            return {
                "status": "ambiguous",
                "candidates": candidates,
            }


        return {
            "status": "not_found",
            "q_bit": q_bit,
        }


    def forward(
        self,
        start_bit: int,
    ) -> Tuple[
        Set[str],
        Set[int],
    ]:

        cells: Set[str] = set()
        bits: Set[int] = {
            start_bit
        }

        queue: deque[int] = deque(
            [
                start_bit
            ]
        )


        while queue:

            current = queue.popleft()


            for name in self.consumers.get(
                current,
                set(),
            ):

                next_bits = outputs_from_input(
                    self.cells[
                        name
                    ],
                    current,
                )

                if not next_bits:
                    continue

                cells.add(
                    name
                )


                for nxt in next_bits:

                    if nxt not in bits:

                        bits.add(
                            nxt
                        )

                        queue.append(
                            nxt
                        )


        return (
            cells,
            bits,
        )


    def backward(
        self,
        end_bit: int,
    ) -> Tuple[
        Set[str],
        Set[int],
    ]:

        cells: Set[str] = set()
        bits: Set[int] = {
            end_bit
        }

        queue: deque[int] = deque(
            [
                end_bit
            ]
        )


        while queue:

            current = queue.popleft()


            for name in self.drivers.get(
                current,
                set(),
            ):

                prev_bits = inputs_for_output(
                    self.cells[
                        name
                    ],
                    current,
                )

                if not prev_bits:
                    continue

                cells.add(
                    name
                )


                for prev in prev_bits:

                    if prev not in bits:

                        bits.add(
                            prev
                        )

                        queue.append(
                            prev
                        )


        return (
            cells,
            bits,
        )


    def precise_cells(
        self,
        forward_cells: Set[str],
        backward_cells: Set[str],
        forward_bits: Set[int],
        backward_bits: Set[int],
    ) -> Set[str]:

        result: Set[str] = set()


        for name in (
            forward_cells
            & backward_cells
        ):

            cell = self.cells[
                name
            ]


            for input_bit in all_inputs(
                cell
            ):

                if input_bit not in forward_bits:
                    continue


                possible_outputs = outputs_from_input(
                    cell,
                    input_bit,
                )


                if (
                    possible_outputs
                    & backward_bits
                ):

                    result.add(
                        name
                    )

                    break


        return result


    def analyze_select_cone(
        self,
        root_bit: int,
    ) -> Dict[str, Any]:

        """
        Analyze the combinational dependency cone of one mux-select bit.

        The walk stops at trusted timing boundaries:

          * top-level primary inputs
          * sequential Q outputs

        It fails closed on:

          * missing drivers
          * multiple combinational drivers
          * combinational cycles
          * driver outputs whose upstream dependency cannot be derived

        Cell/operator counts are derived from unique cell identities so
        reconvergent DAG structure is never double-counted.
        """

        memo: Dict[
            int,
            Dict[str, Any],
        ] = {}

        visiting: Set[int] = set()


        def walk(
            bit: int,
        ) -> Dict[str, Any]:

            if bit in memo:

                cached = memo[bit]

                return {
                    "status": cached["status"],
                    "boundary_input_bits": set(
                        cached["boundary_input_bits"]
                    ),
                    "boundary_register_bits": set(
                        cached["boundary_register_bits"]
                    ),
                    "cells": set(
                        cached["cells"]
                    ),
                    "unresolved_bits": set(
                        cached["unresolved_bits"]
                    ),
                    "max_comb_depth": int(
                        cached["max_comb_depth"]
                    ),
                }


            # --------------------------------------------------
            # Primary-input boundary.
            # --------------------------------------------------

            if self.is_primary_input(
                bit
            ):

                result = {
                    "status": "resolved",
                    "boundary_input_bits": {
                        bit
                    },
                    "boundary_register_bits": set(),
                    "cells": set(),
                    "unresolved_bits": set(),
                    "max_comb_depth": 0,
                }

                memo[bit] = result

                return walk(bit)


            # --------------------------------------------------
            # Sequential-Q boundary.
            # --------------------------------------------------

            if self.q_to_seq.get(
                bit
            ):

                result = {
                    "status": "resolved",
                    "boundary_input_bits": set(),
                    "boundary_register_bits": {
                        bit
                    },
                    "cells": set(),
                    "unresolved_bits": set(),
                    "max_comb_depth": 0,
                }

                memo[bit] = result

                return walk(bit)


            # --------------------------------------------------
            # Combinational-cycle protection.
            # --------------------------------------------------

            if bit in visiting:

                return {
                    "status": "unresolved",
                    "boundary_input_bits": set(),
                    "boundary_register_bits": set(),
                    "cells": set(),
                    "unresolved_bits": {
                        bit
                    },
                    "max_comb_depth": 0,
                }


            drivers = sorted(
                self.drivers.get(
                    bit,
                    set(),
                )
            )


            # --------------------------------------------------
            # Zero or multiple drivers are not trustworthy.
            # --------------------------------------------------

            if len(
                drivers
            ) != 1:

                result = {
                    "status": "unresolved",
                    "boundary_input_bits": set(),
                    "boundary_register_bits": set(),
                    "cells": set(),
                    "unresolved_bits": {
                        bit
                    },
                    "max_comb_depth": 0,
                }

                memo[bit] = result

                return walk(bit)


            driver = drivers[0]

            cell = self.cells[
                driver
            ]


            upstream = sorted(
                inputs_for_output(
                    cell,
                    bit,
                )
            )


            if not upstream:

                result = {
                    "status": "unresolved",
                    "boundary_input_bits": set(),
                    "boundary_register_bits": set(),
                    "cells": {
                        driver
                    },
                    "unresolved_bits": {
                        bit
                    },
                    "max_comb_depth": 1,
                }

                memo[bit] = result

                return walk(bit)


            visiting.add(
                bit
            )


            boundary_inputs: Set[int] = set()

            boundary_registers: Set[int] = set()

            cells: Set[str] = {
                driver
            }

            unresolved: Set[int] = set()

            child_depths: List[int] = []


            for source_bit in upstream:

                child = walk(
                    source_bit
                )

                boundary_inputs.update(
                    child[
                        "boundary_input_bits"
                    ]
                )

                boundary_registers.update(
                    child[
                        "boundary_register_bits"
                    ]
                )

                cells.update(
                    child[
                        "cells"
                    ]
                )

                unresolved.update(
                    child[
                        "unresolved_bits"
                    ]
                )

                child_depths.append(
                    int(
                        child[
                            "max_comb_depth"
                        ]
                    )
                )


            visiting.remove(
                bit
            )


            result = {
                "status": (
                    "resolved"
                    if not unresolved
                    else "unresolved"
                ),
                "boundary_input_bits": (
                    boundary_inputs
                ),
                "boundary_register_bits": (
                    boundary_registers
                ),
                "cells": cells,
                "unresolved_bits": (
                    unresolved
                ),
                "max_comb_depth": (
                    1
                    + max(
                        child_depths,
                        default=0,
                    )
                ),
            }


            memo[bit] = result

            return walk(bit)


        internal = walk(
            root_bit
        )


        unique_cells = sorted(
            internal[
                "cells"
            ]
        )


        operator_counts: Dict[
            str,
            int,
        ] = {}


        for cell_name in unique_cells:

            typ = str(
                self.cells[
                    cell_name
                ].get(
                    "type"
                )
                or "unknown"
            )

            operator_counts[
                typ
            ] = (
                operator_counts.get(
                    typ,
                    0,
                )
                + 1
            )


        if self.is_primary_input(
            root_bit
        ):

            kind = (
                "primary_input"
            )

        elif self.q_to_seq.get(
            root_bit
        ):

            kind = (
                "sequential_q"
            )

        elif len(
            self.drivers.get(
                root_bit,
                set(),
            )
        ) == 1:

            kind = (
                "combinational"
            )

        else:

            kind = (
                "unresolved"
            )


        return {
            "bit": root_bit,
            "status": internal[
                "status"
            ],
            "kind": kind,
            "max_comb_depth": internal[
                "max_comb_depth"
            ],
            "cell_count": len(
                unique_cells
            ),
            "operator_counts": {
                key: operator_counts[key]
                for key in sorted(
                    operator_counts
                )
            },
            "boundary_input_bits": sorted(
                internal[
                    "boundary_input_bits"
                ]
            ),
            "boundary_register_bits": sorted(
                internal[
                    "boundary_register_bits"
                ]
            ),
            "unresolved_bits": sorted(
                internal[
                    "unresolved_bits"
                ]
            ),
        }


    def remaining_reconvergence(
        self,
        precise: Set[str],
        forward_bits: Set[int],
        backward_bits: Set[int],
    ) -> List[Dict[str, Any]]:

        """
        Detect genuine same-bit mux ambiguity.
        """

        points = []


        for name in sorted(
            precise
        ):

            cell = self.cells[
                name
            ]


            if cell.get(
                "type"
            ) != "$mux":

                continue


            a = pbits(
                cell,
                "A",
            )

            b = pbits(
                cell,
                "B",
            )

            y = pbits(
                cell,
                "Y",
            )

            s = pbits(
                cell,
                "S",
            )

            select_bits = sorted(
                {
                    resolved
                    for raw in s
                    if (
                        resolved := bit_id(raw)
                    )
                    is not None
                }
            )

            ambiguous = []


            for index, raw_y in enumerate(
                y
            ):

                y_bit = bit_id(
                    raw_y
                )


                if (
                    y_bit is None
                    or y_bit not in backward_bits
                ):

                    continue


                a_bit = at(
                    a,
                    index,
                )

                b_bit = at(
                    b,
                    index,
                )


                a_live = (
                    a_bit is not None
                    and a_bit in forward_bits
                    and a_bit in backward_bits
                )


                b_live = (
                    b_bit is not None
                    and b_bit in forward_bits
                    and b_bit in backward_bits
                )


                if (
                    a_live
                    and b_live
                ):

                    ambiguous.append(
                        {
                            "output_index": index,
                            "output_bit": y_bit,
                            "a_bit": a_bit,
                            "b_bit": b_bit,
                        }
                    )


            if ambiguous:

                points.append(
                    {
                        "cell": name,
                        "type": "$mux",
                        "select_bits": select_bits,
                        "select_cones": [
                            self.analyze_select_cone(
                                select_bit
                            )
                            for select_bit
                            in select_bits
                        ],
                        "ambiguous_outputs": ambiguous,
                    }
                )


        return points


