class SourceHashCache:
    """Race-aware mapping-time SHA-256 cache for resolved RTL sources."""

    def __init__(self) -> None:
        self._cache: Dict[str, Dict[str, Any]] = {}

    @staticmethod
    def _signature(path: Path) -> Tuple[int, int]:
        st = path.stat()
        return int(st.st_size), int(st.st_mtime_ns)

    def describe(self, path: Path) -> Dict[str, Any]:
        resolved = path.resolve()
        key = str(resolved)
        before = self._signature(resolved)

        cached = self._cache.get(key)
        if cached is not None:
            cached_sig = (int(cached["size_bytes"]), int(cached["mtime_ns"]))
            if before != cached_sig:
                raise RuntimeError(
                    "RTL source changed during map_to_rtl execution: "
                    f"{resolved}"
                )
            return dict(cached)

        h = hashlib.sha256()
        with resolved.open("rb") as f:
            for chunk in iter(lambda: f.read(1024 * 1024), b""):
                h.update(chunk)

        after = self._signature(resolved)
        if after != before:
            raise RuntimeError(
                "RTL source changed while being hashed: "
                f"{resolved}"
            )

        record = {
            "path": key,
            "hash_algorithm": "sha256",
            "sha256": h.hexdigest(),
            "size_bytes": before[0],
            "mtime_ns": before[1],
            "provenance_scope": "mapping_time_source_file",
        }
        self._cache[key] = record
        return dict(record)


def source_integrity_manifest(
    cells: Sequence[Dict[str, Any]],
) -> Dict[str, Any]:
    """Collect exact user-RTL files referenced by one mapped RTL cone."""

    files: Dict[str, Dict[str, Any]] = {}
    errors: List[str] = []

    for cell in cells:
        for source in cell.get("sources", []):
            if source.get("source_type") != "user_rtl":
                continue

            integrity = source.get("source_integrity")
            resolved = source.get("resolved_file")

            if not isinstance(integrity, dict):
                errors.append(
                    "Missing SHA-256 for mapped user RTL source: "
                    f"{resolved or source.get('file')}"
                )
                continue

            file_path = str(integrity.get("path") or resolved or "")
            sha = integrity.get("sha256")

            if not file_path or not sha:
                errors.append(
                    "Incomplete SHA-256 record for mapped user RTL source: "
                    f"{resolved or source.get('file')}"
                )
                continue

            prior = files.get(file_path)
            if prior is not None and prior.get("sha256") != sha:
                errors.append(
                    "Conflicting SHA-256 values for the same RTL file: "
                    f"{file_path}"
                )
                continue

            files[file_path] = {
                "path": file_path,
                "hash_algorithm": "sha256",
                "sha256": sha,
                "size_bytes": integrity.get("size_bytes"),
                "mtime_ns": integrity.get("mtime_ns"),
                "provenance_scope": "mapping_time_source_file",
            }

    status = (
        "complete"
        if files and not errors
        else "not_applicable"
        if not files and not errors
        else "error"
    )

    return {
        "status": status,
        "hash_algorithm": "sha256",
        "provenance_scope": "mapping_time_source_file",
        "files": [files[k] for k in sorted(files)],
        "errors": errors,
    }


def merge_run_source_integrity(
    mapped_paths: Sequence[Dict[str, Any]],
) -> Dict[str, Any]:
    files: Dict[str, Dict[str, Any]] = {}
    errors: List[str] = []

    for path in mapped_paths:
        mapping = path.get("rtl_mapping") or {}
        manifest = mapping.get("source_integrity") or {}

        errors.extend(str(e) for e in manifest.get("errors", []))

        for item in manifest.get("files", []):
            file_path = str(item.get("path") or "")
            sha = item.get("sha256")
            if not file_path or not sha:
                errors.append(f"Incomplete path-level source-integrity item: {item}")
                continue

            prior = files.get(file_path)
            if prior is not None and prior.get("sha256") != sha:
                errors.append(
                    "Conflicting path-level SHA-256 values for RTL file: "
                    f"{file_path}"
                )
                continue

            files[file_path] = dict(item)

    status = (
        "complete"
        if files and not errors
        else "not_applicable"
        if not files and not errors
        else "error"
    )

    return {
        "status": status,
        "hash_algorithm": "sha256",
        "provenance_scope": "mapping_time_source_file",
        "files": [files[k] for k in sorted(files)],
        "errors": sorted(set(errors)),
    }


def norm(value: Any) -> Optional[str]:
    if value is None:
        return None

    text = str(value).strip()

    if text.startswith("\\"):
        text = text[1:]

    return text or None


def reg_signal(value: Any) -> Optional[str]:
    text = norm(value)

    if not text:
        return None

    text = PIN_SUFFIX_RE.sub("", text)
    return DFF_SUFFIX_RE.sub("", text)


def bit_id(value: Any) -> Optional[int]:
    if isinstance(value, int) and not isinstance(value, bool):
        return int(value)

    return None


def ints(bits: Sequence[Any]) -> List[int]:
    return [
        int(value)
        for value in bits
        if bit_id(value) is not None
    ]


def conns(cell: Dict[str, Any]) -> Dict[str, List[Any]]:
    return cell.get("connections") or {}


def dirs(cell: Dict[str, Any]) -> Dict[str, str]:
    return cell.get("port_directions") or {}


def find_port(
    cell: Dict[str, Any],
    *names: str,
) -> Optional[str]:

    ports = {
        str(port).lstrip("\\").upper(): port
        for port in conns(cell)
    }

    for name in names:
        if name.upper() in ports:
            return ports[name.upper()]

    return None


def pbits(
    cell: Dict[str, Any],
    *names: str,
) -> List[Any]:

    port = find_port(cell, *names)

    if port is None:
        return []

    return list(
        conns(cell).get(port, [])
    )


def at(
    bits: Sequence[Any],
    index: int,
) -> Optional[int]:

    if index < 0 or index >= len(bits):
        return None

    return bit_id(bits[index])


def positions(
    bits: Sequence[Any],
    target: int,
) -> List[int]:

    return [
        index
        for index, value in enumerate(bits)
        if bit_id(value) == target
    ]


def all_inputs(
    cell: Dict[str, Any],
) -> Set[int]:

    result: Set[int] = set()

    for port, bits in conns(cell).items():

        if dirs(cell).get(port) in (
            "input",
            "inout",
        ):
            result.update(
                ints(bits)
            )

    if not result:
        result.update(
            ints(
                cell.get(
                    "input_bits",
                    [],
                )
            )
        )

    return result


def all_outputs(
    cell: Dict[str, Any],
) -> Set[int]:

    result: Set[int] = set()

    for port, bits in conns(cell).items():

        if dirs(cell).get(port) in (
            "output",
            "inout",
        ):
            result.update(
                ints(bits)
            )

    if not result:
        result.update(
            ints(
                cell.get(
                    "output_bits",
                    [],
                )
            )
        )

    return result


# ---------------------------------------------------------------------------
# Bit dependency semantics
# ---------------------------------------------------------------------------

def outputs_from_input(
    cell: Dict[str, Any],
    input_bit: int,
) -> Set[int]:

    """
    Return output bits that may depend on input_bit.
    """

    typ = str(
        cell.get("type") or ""
    )

    a = pbits(cell, "A")
    b = pbits(cell, "B")
    y = pbits(cell, "Y")

    # -------------------------------------------------------
    # Bitwise:
    #
    # A[i] -> Y[i]
    # B[i] -> Y[i]
    # -------------------------------------------------------

    if typ in BITWISE_BINARY:

        result: Set[int] = set()

        for data in (a, b):

            for index in positions(
                data,
                input_bit,
            ):

                out = at(
                    y,
                    index,
                )

                if out is not None:
                    result.add(out)

        return result


    # -------------------------------------------------------
    # Unary:
    #
    # A[i] -> Y[i]
    # -------------------------------------------------------

    if typ in BITWISE_UNARY:

        result: Set[int] = set()

        for index in positions(
            a,
            input_bit,
        ):

            out = at(
                y,
                index,
            )

            if out is not None:
                result.add(out)

        return result


    # -------------------------------------------------------
    # MUX:
    #
    # A[i] -> Y[i]
    # B[i] -> Y[i]
    # S    -> every Y bit
    # -------------------------------------------------------

    if typ == "$mux":

        result: Set[int] = set()

        for data in (a, b):

            for index in positions(
                data,
                input_bit,
            ):

                out = at(
                    y,
                    index,
                )

                if out is not None:
                    result.add(out)

        s = pbits(
            cell,
            "S",
        )

        if input_bit in ints(s):
            result.update(
                ints(y)
            )

        return result


    # -------------------------------------------------------
    # ADD / SUB:
    #
    # input bit i can affect:
    #
    # Y[i], Y[i+1], ..., Y[MSB]
    #
    # because of carry / borrow propagation.
    # -------------------------------------------------------

    if typ in ARITH_CARRY:

        result: Set[int] = set()

        for data in (a, b):

            for index in positions(
                data,
                input_bit,
            ):

                for out_index in range(
                    index,
                    len(y),
                ):

                    out = at(
                        y,
                        out_index,
                    )

                    if out is not None:
                        result.add(out)

        return result


    # -------------------------------------------------------
    # MUL:
    #
    # Conservative approximation:
    # input bit i cannot affect result bits below i.
    # -------------------------------------------------------

    if typ == "$mul":

        result: Set[int] = set()

        for data in (a, b):

            for index in positions(
                data,
                input_bit,
            ):

                for out_index in range(
                    index,
                    len(y),
                ):

                    out = at(
                        y,
                        out_index,
                    )

                    if out is not None:
                        result.add(out)

        return result


    # -------------------------------------------------------
    # Compare/reduce/shift etc.
    #
    # Conservative global dependency.
    # -------------------------------------------------------

    if typ in GLOBAL_OPS:
        return all_outputs(cell)


    # -------------------------------------------------------
    # Unknown operator:
    #
    # Never delete a possibly valid path.
    # -------------------------------------------------------

    return all_outputs(cell)


def inputs_for_output(
    cell: Dict[str, Any],
    output_bit: int,
) -> Set[int]:

    """
    Return input bits that may affect output_bit.
    """

    typ = str(
        cell.get("type") or ""
    )

    a = pbits(cell, "A")
    b = pbits(cell, "B")
    y = pbits(cell, "Y")

    if y and output_bit not in ints(y):
        return set()


    # -------------------------------------------------------
    # Bitwise:
    #
    # Y[i] depends on A[i], B[i]
    # -------------------------------------------------------

    if typ in BITWISE_BINARY:

        result: Set[int] = set()

        for index in positions(
            y,
            output_bit,
        ):

            for data in (a, b):

                src = at(
                    data,
                    index,
                )

                if src is not None:
                    result.add(src)

        return result


    # -------------------------------------------------------
    # Unary:
    # -------------------------------------------------------

    if typ in BITWISE_UNARY:

        result: Set[int] = set()

        for index in positions(
            y,
            output_bit,
        ):

            src = at(
                a,
                index,
            )

            if src is not None:
                result.add(src)

        return result


    # -------------------------------------------------------
    # MUX:
    #
    # Y[i] depends on A[i], B[i], S
    # -------------------------------------------------------

    if typ == "$mux":

        result: Set[int] = set()

        for index in positions(
            y,
            output_bit,
        ):

            for data in (a, b):

                src = at(
                    data,
                    index,
                )

                if src is not None:
                    result.add(src)

        result.update(
            ints(
                pbits(
                    cell,
                    "S",
                )
            )
        )

        return result


    # -------------------------------------------------------
    # ADD / SUB:
    #
    # Y[k] depends on inputs 0..k.
    # -------------------------------------------------------

    if typ in ARITH_CARRY:

        result: Set[int] = set()

        for out_index in positions(
            y,
            output_bit,
        ):

            for data in (a, b):

                upper = min(
                    out_index + 1,
                    len(data),
                )

                for src_index in range(
                    upper
                ):

                    src = at(
                        data,
                        src_index,
                    )

                    if src is not None:
                        result.add(src)

        return result


    # -------------------------------------------------------
    # MUL
    # -------------------------------------------------------

    if typ == "$mul":

        result: Set[int] = set()

        for out_index in positions(
            y,
            output_bit,
        ):

            for data in (a, b):

                upper = min(
                    out_index + 1,
                    len(data),
                )

                for src_index in range(
                    upper
                ):

                    src = at(
                        data,
                        src_index,
                    )

                    if src is not None:
                        result.add(src)

        return result


    if typ in GLOBAL_OPS:
        return all_inputs(cell)


    return all_inputs(cell)


