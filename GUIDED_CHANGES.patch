+               "top": request["source_bundle"]["top"],
+               "source": {**source, "verilog": request["source_text"]},
+               "source_bundle": request["source_bundle"], "candidate_contract": request["candidate_contract"],
+               "user_ppa_budgets": request.get("user_ppa_budgets", {}),
