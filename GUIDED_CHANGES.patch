+                                     if k != "worst_setup_path_excerpt"},
+               "guidance": packet, "response_schema": schema}
+    # Feedback shares the advisory cap with guidance, including its newest outcome.
+    # The packet already contains compact prior outcomes; do not duplicate unbounded logs.
+    if feedback and not packet.get("prior_attempt_outcomes"):
+        compact = {k: feedback.get(k) for k in ("outcome_type", "instruction", "ppa_deltas")}
+        if len(json.dumps({**packet, "latest_feedback": compact}, sort_keys=True)) <= max_guidance_chars:
+            packet["latest_feedback"] = compact
