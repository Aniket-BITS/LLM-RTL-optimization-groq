# Generated by nEBULA constraint_model.py; units: ns.
proc nebula_objects {kind names} {
  set result {}
  foreach name $names {
    set objects [get_$kind $name]
    if {[llength $objects] == 0} {error "Unresolved timing object: $kind $name"}
    foreach object $objects {lappend result $object}
  }
  return $result
}
create_clock -name {core_clock} -period 0.8 [nebula_objects ports [list {clk}]]
set_clock_uncertainty 0 [nebula_objects clocks [list {core_clock}]]
set_input_delay -min 0.0 -clock {core_clock} [nebula_objects ports [list {a} {b} {c} {sel}]]
set_input_delay -max 0.0 -clock {core_clock} [nebula_objects ports [list {a} {b} {c} {sel}]]
set_output_delay -min 0.0 -clock {core_clock} [nebula_objects ports [list {y}]]
set_output_delay -max 0.0 -clock {core_clock} [nebula_objects ports [list {y}]]
